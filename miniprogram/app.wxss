/* app.wxss - 全局样式 */
/* 引入主题样式 */
@import '/theme/theme.wxss';
/* 引入 iconfont 字体图标 */
@import '/styles/iconfont.wxss';

/* ========== 页面基础 ========== */
page {
  background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
}

/* ========== 按钮规范 ========== */
/* 主要按钮 - 主题色渐变 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  font-size: var(--font-base);
  font-weight: 500;
  border-radius: var(--radius-lg);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

/* 次要按钮 - 白底主题色边框 */
.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: #4A90D9;
  font-size: var(--font-base);
  font-weight: 500;
  border-radius: var(--radius-lg);
  border: 2rpx solid #4A90D9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary::after {
  border: none;
}

/* 文字按钮 - 主题色 */
.btn-text {
  background: transparent;
  color: #4A90D9;
  font-size: var(--font-base);
  padding: 0;
  border: none;
}

.btn-text::after {
  border: none;
}

/* ========== 表单规范 ========== */
/* 所有输入框必须遵循以下规范，确保placeholder完整显示 */

/* 单行输入框 */
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  color: var(--text-primary);
  border: 1rpx solid transparent;
  transition: all var(--duration-fast);
  box-sizing: border-box;
  line-height: 88rpx;
}

.form-input:focus {
  border-color: var(--color-primary);
  background: var(--bg-card);
}

.form-input::placeholder {
  color: var(--text-placeholder) !important;
  font-size: var(--font-base) !important;
  overflow: visible !important;
}

/* 多行文本框 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.6;
  border: 1rpx solid transparent;
  transition: all var(--duration-fast);
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: var(--color-primary);
  background: var(--bg-card);
}

.form-textarea::placeholder {
  color: var(--text-placeholder) !important;
  font-size: var(--font-base) !important;
  overflow: visible !important;
}

/* 表单标签 */
.form-label {
  display: block;
  font-size: var(--font-base);
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}

/* 表单分组 */
.form-section {
  margin-bottom: var(--spacing-lg);
}

/* ========== 半屏弹窗统一规范 ========== */
.weui-half-screen-dialog {
  height: 70vh !important;
  max-height: 70vh !important;
  border-radius: 32rpx 32rpx 0 0 !important;
}

.publish-dialog .weui-half-screen-dialog__bd,
.vote-dialog .weui-half-screen-dialog__bd,
.profile-dialog .weui-half-screen-dialog__bd,
.notice-dialog .weui-half-screen-dialog__bd {
  height: calc(70vh - 100rpx) !important;
  max-height: calc(70vh - 100rpx) !important;
  overflow-y: auto;
}

/* 隐藏半屏弹框右侧的"更多"按钮 */
.publish-dialog .weui-half-screen-dialog__hd__side:last-child,
.vote-dialog .weui-half-screen-dialog__hd__side:last-child,
.profile-dialog .weui-half-screen-dialog__hd__side:last-child,
.notice-dialog .weui-half-screen-dialog__hd__side:last-child {
  display: none !important;
}

.dialog-title-row,
.dialog-title-bar {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  width: 100% !important;
}

.dialog-title {
  font-size: 34rpx !important;
  font-weight: 700 !important;
  color: var(--text-primary) !important;
}

.dialog-submit-btn,
.save-btn-top {
  min-width: 112rpx !important;
  height: 60rpx !important;
  padding: 0 28rpx !important;
  border-radius: 30rpx !important;
  border: none !important;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%) !important;
  color: #FFFFFF !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  line-height: 60rpx !important;
  text-align: center !important;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.24) !important;
  transition: all var(--duration-fast) !important;
}

.dialog-submit-btn:active:not(.disabled),
.save-btn-top:active:not(.disabled) {
  transform: scale(0.94) !important;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.2) !important;
}

.dialog-submit-btn.disabled,
.save-btn-top.disabled {
  background: #E8EAF0 !important;
  color: #B0B8C8 !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.save-btn-top::after {
  border: none !important;
}

.dialog-body {
  padding: 8rpx 16rpx 0 !important;
  overflow-x: hidden !important;
}

.dialog-body .form-section,
.dialog-body .form-item,
.dialog-body .form-row {
  margin-bottom: 20rpx !important;
}

.dialog-body .form-input,
.dialog-body .form-picker,
.dialog-body .form-textarea {
  width: 100% !important;
  background: #F7F9FC !important;
  border: 2rpx solid transparent !important;
  border-radius: 18rpx !important;
  box-sizing: border-box !important;
  color: var(--text-primary) !important;
  font-size: 28rpx !important;
}

.dialog-body .form-input,
.dialog-body .form-picker {
  min-height: 88rpx !important;
  height: 88rpx !important;
  padding: 0 28rpx !important;
  line-height: 88rpx !important;
}

.dialog-body .form-textarea {
  min-height: 168rpx !important;
  padding: 24rpx 28rpx !important;
  line-height: 1.6 !important;
}

.dialog-body .placeholder {
  color: var(--text-placeholder) !important;
}

/* ========== 图片网格 ========== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--spacing-sm);
}

.image-grid image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  margin-right: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  object-fit: cover;
}

.image-grid image:nth-child(3n) {
  margin-right: 0;
}

/* ========== 动画类 ========== */
/* 淡入 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn var(--duration-normal) ease-out;
}

/* 上滑淡入 */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp var(--duration-normal) ease-out;
}

/* 缩放 */
@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.scale-in {
  animation: scaleIn var(--duration-normal) ease-out;
}

/* 脉冲 */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.pulse {
  animation: pulse 2s ease-in-out infinite;
}
