/* components/post-card/post-card.wxss */

.post-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background-color: var(--bg-primary);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 头部 */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid var(--border-color);
}

.user-info {
  flex: 1;
}

.nick-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.post-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 4rpx;
}

/* 内容 */
.post-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-primary);
  word-break: break-all;
}

/* 图片 */
.post-images {
  margin-bottom: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.post-images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

/* 标签 */
.post-tags {
  margin-bottom: 20rpx;
}

.post-tags .tag {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, rgba(107, 127, 255, 0.1) 0%, rgba(139, 159, 255, 0.1) 100%);
  color: var(--primary-color);
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 操作栏 */
.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
  margin-top: 8rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 12rpx 0;
  border-radius: 24rpx;
  transition: background-color 0.2s;
  gap: 8rpx;
}

.action-item:active {
  background-color: var(--bg-secondary);
}

.action-item.liked .iconfont {
  color: #FF6B6B;
  animation: likeAnimation 0.3s ease;
}

@keyframes likeAnimation {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.action-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.action-item.liked .action-text {
  color: #FF4D4F;
}

/* 分享按钮样式重置 */
.share-btn {
  background: transparent;
  padding: 12rpx 24rpx;
  margin: 0;
  line-height: normal;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn::after {
  border: none;
}