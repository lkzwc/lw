/* ========== 图标尺寸变体 ========== */
.iconfont-sm { font-size: 32rpx; }
.iconfont-md { font-size: 40rpx; }
.iconfont-lg { font-size: 48rpx; }
.iconfont-xl { font-size: 56rpx; }

/* ========== 图标颜色变体 ========== */
.iconfont-primary { color: #4A90D9; }
.iconfont-active { color: #4A90D9; }
.iconfont-secondary { color: #999999; }
.iconfont-disabled { color: #CCCCCC; }
.iconfont-white { color: #FFFFFF; }
.iconfont-liked { color: #FF6B6B; }

