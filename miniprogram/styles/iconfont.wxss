/* ========== iconfont 字体图标 ========== */

/* 字体引入 */
@font-face {
  font-family: 'iconfont';
  src: url('/assets/fonts/iconfont.woff2?t=1778686293891') format('woff2'),
       url('/assets/fonts/iconfont.woff?t=1778686293891') format('woff'),
       url('/assets/fonts/iconfont.ttf?t=1778686293891') format('truetype');
}

/* 基础样式 */
.iconfont {
  font-family: 'iconfont' !important;
  font-size: 40rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

