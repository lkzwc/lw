/* ========== iconfont 字体图标 ========== */

/* 字体引入 - 本地路径（开发工具可用）+ wx.loadFontFace base64 真机降级 */
@font-face {
  font-family: 'iconfont';
   src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
        url('data:font/woff;charset=utf-8;base64,') format('woff');
}

/* 基础样式 */
.iconfont {
  font-family: 'iconfont' !important;
  font-size: 40rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ========== 图标类名 ========== */

/* 帖子操作栏 */
/* 点赞图标：字体文件只有单个填充心形 glyph（\e768）
   - 已点赞（icon-dianzan1）：红色 #FF6B6B
   - 未点赞（icon-dianzan）：继承父级灰色
   这是标准UX做法，无需独立空心glyph。如需更新字体文件添加空心版，
   请到 iconfont.cn 项目中同时选择"点赞"和"点赞1"两个图标后重新下载。 */
.icon-dianzan:before { content: '\e768'; }     /* 点赞 - 默认灰色空心 */
.icon-dianzan1:before { content: '\e768'; }    /* 点赞 - 已激活（CSS 颜色变红） */
