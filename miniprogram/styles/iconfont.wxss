@font-face {
  font-family: 'iconfont';
  src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
      url('data:font/woff;charset=utf-8;base64,') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

.iconfont {
  font-family: "iconfont" !important;
  font-size: 44rpx;
  color: #4A90D9;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
/* 浅灰色图标 */
.icon-muted {
  color: var(--text-placeholder, #CCCCCC);
}

/* 白色图标（深色背景上使用） */
.icon-white {
  color: #FFFFFF;
}

/* 白色半透明图标（头像占位等） */
.icon-white-light {
  color: rgba(255, 255, 255, 0.7);
}

/* 搜索栏图标（半透明白色） */
.icon-search-bar {
  color: rgba(255, 255, 255, 0.7);
}

/* 占位符/空状态图标 */
.icon-placeholder {
  color: var(--text-placeholder, #CCCCCC);
  opacity: 0.5;
}

/* 兜底占位图标（卡片中无图片时） */
.icon-placeholder-card {
  color: #B0C4DE;
}

/* 点赞激活（红色） */
.icon-liked {
  color: #FF6B6B;
}

/* 管理员标识（橙色） */
.icon-admin {
  color: #FF9800;
}

/* 活动详情-时间图标（黄色） */
.icon-time-accent {
  color: #FAAD14;
}

/* 活动详情-人数图标（绿色） */
.icon-people-accent {
  color: #52C41A;
}

/* ========== 字号辅助 ========== */

.icon-xs { font-size: 24rpx; }
.icon-sm { font-size: 28rpx; }
.icon-md { font-size: 32rpx; }
.icon-lg { font-size: 40rpx; }
.icon-xl { font-size: 44rpx; }
.icon-xxl { font-size: 56rpx; }
.icon-xxxl { font-size: 80rpx; }
.icon-huge { font-size: 120rpx; }

