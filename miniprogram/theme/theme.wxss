/**
 * 主题样式文件 - 邻里圈社区小程序
 * 基于主题配置生成的全局样式变量
 * 修改 theme/index.js 后同步更新此文件
 */

/* ========== CSS变量定义 ========== */
page {
  /* 核心色板 - 浅蓝色主题 */
  --color-primary: #4A90D9;
  --color-primary-light: #6BA8E8;
  --color-primary-dark: #3A7BC8;
  --color-primary-bg: rgba(74, 144, 217, 0.1);
  
  /* 主题渐变 */
  --gradient-primary: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  
  --color-secondary: #FF6B35;
  --color-secondary-light: #FF8B5A;
  --color-secondary-dark: #E55A25;
  --color-secondary-bg: rgba(255, 107, 53, 0.1);
  
  /* 功能色 */
  --color-success: #52C41A;
  --color-warning: #FAAD14;
  --color-error: #FF4D4F;
  --color-info: #1890FF;
  
  /* 文字色 */
  --text-primary: #2D2D2D;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --text-disabled: #CCCCCC;
  --text-white: #FFFFFF;
  
  /* 背景色 */
  --bg-primary: #F4F7FB;
  --bg-secondary: #FFFFFF;
  --bg-card: #FFFFFF;
  --bg-mask: rgba(0, 0, 0, 0.5);
  
  /* 玻璃拟态 */
  --glass-bg: rgba(255, 255, 255, 0.72);
  --glass-border: rgba(255, 255, 255, 0.5);
  
  /* 边框色 */
  --border-color: #E8F0F8;
  --border-light: #F0F5FA;
  --border-dark: #D8E8F5;
  
  /* 字号 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 44rpx;
  --font-xxl: 56rpx;
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-xxl: 64rpx;
  
  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-round: 999rpx;
  
  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(74, 144, 217, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(74, 144, 217, 0.12);
  --shadow-lg: 0 8rpx 32rpx rgba(74, 144, 217, 0.16);
  --shadow-card: 0 4rpx 20rpx rgba(45, 45, 45, 0.06);
  --shadow-float: 0 8rpx 40rpx rgba(45, 45, 45, 0.12);
  
  /* 动画时长 */
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 400ms;
  
  /* 页面基础设置 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-base);
  color: var(--text-primary);
  background-color: var(--bg-primary);
}

/* ========== 通用布局类 ========== */
.flex { display: flex; }
.flex-column { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-center { justify-content: center; align-items: center; }
.flex-between { justify-content: space-between; align-items: center; }
.flex-around { justify-content: space-around; align-items: center; }
.flex-start { justify-content: flex-start; align-items: center; }
.flex-end { justify-content: flex-end; align-items: center; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* ========== 文字类 ========== */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-secondary); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }
.text-muted { color: var(--text-secondary); }
.text-placeholder { color: var(--text-placeholder); }
.text-white { color: var(--text-white); }

.text-xs { font-size: var(--font-xs); }
.text-sm { font-size: var(--font-sm); }
.text-base { font-size: var(--font-base); }
.text-md { font-size: var(--font-md); }
.text-lg { font-size: var(--font-lg); }
.text-xl { font-size: var(--font-xl); }
.text-xxl { font-size: var(--font-xxl); }

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.text-bold { font-weight: 600; }
.text-medium { font-weight: 500; }
.text-normal { font-weight: 400; }

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 间距类 ========== */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

.ml-xs { margin-left: var(--spacing-xs); }
.ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }
.ml-lg { margin-left: var(--spacing-lg); }

.mr-xs { margin-right: var(--spacing-xs); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }
.mr-lg { margin-right: var(--spacing-lg); }

.p-xs { padding: var(--spacing-xs); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }

.px-sm { padding-left: var(--spacing-sm); padding-right: var(--spacing-sm); }
.px-md { padding-left: var(--spacing-md); padding-right: var(--spacing-md); }
.px-lg { padding-left: var(--spacing-lg); padding-right: var(--spacing-lg); }

.py-sm { padding-top: var(--spacing-sm); padding-bottom: var(--spacing-sm); }
.py-md { padding-top: var(--spacing-md); padding-bottom: var(--spacing-md); }
.py-lg { padding-top: var(--spacing-lg); padding-bottom: var(--spacing-lg); }

/* ========== 卡片样式 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
}

.card-warm {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF5 100%);
  border: 1rpx solid rgba(74, 144, 217, 0.1);
}

.card-shadow {
  box-shadow: var(--shadow-md);
}

.card-flat {
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

/* ========== 按钮样式 ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-round);
  font-size: var(--font-base);
  font-weight: 500;
  transition: all var(--duration-fast);
  border: none;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--gradient-primary);
  color: var(--text-white);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 217, 0.3);
}

.btn-secondary {
  background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-secondary-light) 100%);
  color: var(--text-white);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-outline-secondary {
  background: transparent;
  color: var(--color-secondary);
  border: 2rpx solid var(--color-secondary);
}

.btn-ghost {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.btn-sm {
  padding: 16rpx 32rpx;
  font-size: var(--font-sm);
}

.btn-md {
  padding: 20rpx 48rpx;
  font-size: var(--font-base);
}

.btn-lg {
  padding: 24rpx 64rpx;
  font-size: var(--font-md);
}

.btn-block {
  width: 100%;
}

/* ========== 标签样式 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 500;
}

.tag-primary {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.tag-secondary {
  background: var(--color-secondary-bg);
  color: var(--color-secondary);
}

.tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--color-success);
}

.tag-warning {
  background: rgba(250, 173, 20, 0.1);
  color: var(--color-warning);
}

.tag-error {
  background: rgba(255, 77, 79, 0.1);
  color: var(--color-error);
}

/* ========== 输入框样式 ========== */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  color: var(--text-primary);
  border: 1rpx solid transparent;
  transition: all var(--duration-fast);
}

.input:focus {
  border-color: var(--color-primary);
  background: var(--bg-card);
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.6;
  border: 1rpx solid transparent;
  transition: all var(--duration-fast);
}

.textarea:focus {
  border-color: var(--color-primary);
  background: var(--bg-card);
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: var(--spacing-md) 0;
}

.divider-lg {
  height: 16rpx;
  background: var(--bg-secondary);
  margin: 0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx var(--spacing-lg);
}

.empty-state-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.6;
}

.empty-state-text {
  color: var(--text-placeholder);
  font-size: var(--font-base);
  margin-bottom: var(--spacing-lg);
}

/* 通用空状态文字 */
.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* ========== 帖子卡片通用子元素 ========== */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.post-footer {
  display: flex;
  justify-content: space-around;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.post-stat {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.post-content {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--spacing-sm);
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-xl);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 头像 ========== */
.avatar {
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-secondary);
}

.avatar-xs { width: 48rpx; height: 48rpx; }
.avatar-sm { width: 64rpx; height: 64rpx; }
.avatar-md { width: 80rpx; height: 80rpx; }
.avatar-lg { width: 120rpx; height: 120rpx; }
.avatar-xl { width: 160rpx; height: 160rpx; }

/* ========== 徽标 ========== */
.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-error);
  color: var(--text-white);
  font-size: var(--font-xs);
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-dot {
  width: 16rpx;
  height: 16rpx;
  padding: 0;
  min-width: auto;
}

/* ========== FAB 浮动按钮 ========== */
.fab-btn {
  position: fixed;
  right: var(--spacing-md);
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 150;
}

.fab-btn:active {
  transform: scale(0.94);
}

/* 有底部 TabBar 时，需抬高避开遮挡 */
.fab-btn--tabbar {
  bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 安全区域 ========== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}
