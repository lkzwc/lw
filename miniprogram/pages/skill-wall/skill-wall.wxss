/* pages/skill-wall/skill-wall.wxss */

.skill-wall-page {
  overflow-x: hidden;
  padding-bottom: 120rpx;
  background: #F5F7FA;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  overflow: hidden;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  box-shadow: none;
  border-bottom: none;
}

.nav-placeholder {
  width: 100%;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--spacing-md);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-right {
  width: 72rpx;
}

/* 搜索栏 */
.search-bar {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  padding: 0 24rpx var(--spacing-md);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  padding: 20rpx 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
}

.search-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 分类筛选 */
.category-scroll {
  background-color: #fff;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 12rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background-color: #f5f7fa;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.category-item.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
}

.category-icon {
  margin-right: 8rpx;
}

/* 技能列表 */
.skill-list {
  padding: 0 24rpx;
  margin-top: 16rpx;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 48rpx;
  text-align: center;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
  color: #bbb;
  font-size: 26rpx;
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
}

.publish-btn:active {
  transform: scale(0.95);
}

/* 半屏弹窗标题栏 */
.dialog-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

/* 半屏弹窗 - 按钮样式继承全局 app.wxss */

/* 半屏弹窗内容 */
.dialog-body {
  padding: 8rpx 16rpx 0;
  overflow-x: hidden;
}

.form-section {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.required {
  color: #FF4D4F;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  padding: 16rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* 分类选择 */
.category-select {
  white-space: nowrap;
}

.category-option {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-right: 10rpx;
  background-color: #f5f7fa;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.category-option.selected {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
}

.category-option .category-icon {
  margin-right: 6rpx;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.image-item {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 28rpx;
  height: 28rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.image-add {
  width: 100rpx;
  height: 100rpx;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.add-icon {
  width: 28rpx;
  height: 28rpx;
}

.add-text {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}
