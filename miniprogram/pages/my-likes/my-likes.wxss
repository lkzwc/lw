/* pages/my-likes/my-likes.wxss */

.my-likes-page {
  min-height: 100vh;
  background: #F5F7FA;
}

.items-list {
  padding: var(--spacing-md);
}

/* ========== mp-slideview 卡片间距 ========== */
mp-slideview {
  margin-bottom: 24rpx;
}

/* ========== 点赞卡片 ========== */
.like-card {
  padding: 28rpx;
  border-radius: 20rpx;
  background-color: var(--bg-card);
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid var(--border-color);
}

.user-info {
  flex: 1;
}

.nick-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.post-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 4rpx;
}

.post-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-primary);
  word-break: break-all;
}

.post-images {
  margin-bottom: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.post-images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

/* 操作栏 */
.post-actions {
  display: flex;
  justify-content: flex-start;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
  margin-top: 8rpx;
  gap: 48rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.action-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 已点赞样式 */
.action-item.liked .iconfont {
  color: #FF6B6B;
}

.action-item.liked .unlike-text {
  color: #FF4D4F;
}

/* ========== 公共 ========== */
.load-more,
.no-more {
  text-align: center;
  padding: var(--spacing-md);
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx var(--spacing-lg);
}
