<!--pages/my-posts/my-posts.wxml-->
<view class="my-posts-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight || 0}}px;"></view>
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">{{navTitle}}</text>
      <view class="nav-right"></view>
    </view>
  </view>
  <view style="height: {{(statusBarHeight || 0) + 44}}px;"></view>

  <!-- 帖子列表 -->
  <view class="items-list" wx:if="{{type === 'post'}}">
    <mp-slideview wx:for="{{posts}}" wx:key="_id" show="{{false}}" buttons="{{slideButtons}}" bindbuttontap="onSlideButtonTap" data-index="{{index}}" data-id="{{item._id}}" data-type="post">
      <view class="post-card" bindtap="onItemTap" data-id="{{item._id}}" data-type="post">
        <!-- 用户信息 -->
        <view class="post-header">
          <image class="avatar" src="{{item.userInfo.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="user-info">
            <view class="nick-name">{{item.userInfo.nickName || '匿名用户'}}</view>
            <view class="post-time">{{item.createTimeStr}}</view>
          </view>
        </view>
        <!-- 内容 -->
        <view class="post-content">
          <text class="content-text">{{item.content}}</text>
        </view>
        <!-- 图片 -->
        <view class="post-images image-grid" wx:if="{{item.images && item.images.length > 0}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill"></image>
        </view>
      </view>
    </mp-slideview>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{posts.length === 0 && !loading}}">
      <text class="iconfont icon-tiezhi icon-huge"></text>
      <text class="empty-text">暂无发布</text>
      <text class="empty-hint">去社区发布你的第一条帖子吧</text>
    </view>
  </view>

  <!-- 技能列表 -->
  <view class="items-list" wx:if="{{type === 'skill'}}">
    <mp-slideview wx:for="{{skills}}" wx:key="_id" show="{{false}}" buttons="{{slideButtons}}" bindbuttontap="onSlideButtonTap" data-index="{{index}}" data-id="{{item._id}}" data-type="skill" ext-class="slideview-item">
      <skill-card skill="{{item}}" bindtap="onItemTap" data-id="{{item._id}}" data-type="skill"></skill-card>
    </mp-slideview>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{skills.length === 0 && !loading}}">
      <text class="iconfont icon-gongju icon-huge"></text>
      <text class="empty-text">暂无技能</text>
      <text class="empty-hint">去技能墙发布你的技能吧</text>
    </view>
  </view>

  <!-- 拼车列表 -->
  <view class="items-list" wx:if="{{type === 'carpool'}}">
    <mp-slideview wx:for="{{carpools}}" wx:key="_id" show="{{false}}" buttons="{{slideButtons}}" bindbuttontap="onSlideButtonTap" data-index="{{index}}" data-id="{{item._id}}" data-type="carpool">
      <view class="carpool-card" bindtap="onItemTap" data-id="{{item._id}}" data-type="carpool">
        <view class="carpool-route">
          <view class="route-point">
            <text class="route-dot start"></text>
            <text class="route-text">{{item.start}}</text>
          </view>
          <view class="route-arrow">
            <text class="iconfont icon-qiche"></text>
          </view>
          <view class="route-point">
            <text class="route-dot end"></text>
            <text class="route-text">{{item.end}}</text>
          </view>
        </view>
        <view class="carpool-info">
          <view class="carpool-tag" wx:if="{{item.type === 'long'}}">长期</view>
          <view class="carpool-tag once" wx:else>单次</view>
          <text class="carpool-time">{{item.timeStr || item.schedule}}</text>
          <text class="carpool-seats">{{item.seats}}座</text>
        </view>
        <view class="carpool-footer">
          <text class="carpool-time-ago">{{item.createTimeStr}}</text>
        </view>
      </view>
    </mp-slideview>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{carpools.length === 0 && !loading}}">
      <text class="iconfont icon-qiche icon-huge"></text>
      <text class="empty-text">暂无路线</text>
      <text class="empty-hint">去捎一段发布你的路线吧</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{(posts.length > 0 || skills.length > 0 || carpools.length > 0) && hasMore}}">
    <text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{(posts.length > 0 || skills.length > 0 || carpools.length > 0) && !hasMore}}">
    <text>没有更多了</text>
  </view>
</view>

<loading wx:if="{{loading}}"></loading>
