<!--pages/my-posts/my-posts.wxml-->
<view class="my-posts-page">
  <!-- 标题 -->
  <view class="page-header">
    <text class="page-title">我的发布</text>
  </view>

  <!-- 帖子列表 -->
  <view class="posts-list">
    <post-card wx:for="{{posts}}" wx:key="_id" post="{{item}}"></post-card>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{posts.length === 0 && !loading}}">
    <text class="iconfont icon-tiezhi empty-icon-font"></text>
    <text class="empty-text">暂无发布</text>
    <text class="empty-hint">去社区发布你的第一条帖子吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{posts.length > 0 && hasMore}}">
    <text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{posts.length > 0 && !hasMore}}">
    <text>没有更多了</text>
  </view>
</view>

<loading wx:if="{{loading}}"></loading>