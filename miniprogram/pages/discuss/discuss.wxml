<!--pages/discuss/discuss.wxml - 业主议事厅列表版-->
<view class="discuss-page">

  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight || 0}}px;"></view>
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">业主议事厅</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 自定义导航栏占位 -->
  <view style="height: {{(statusBarHeight || 0) + 44}}px;"></view>

  <!-- 页面标题区 -->
  <view class="page-header">
    <text class="page-subtitle">共商共议，共建美好家园</text>
  </view>

  <!-- 议题列表 -->
  <view class="topic-list">
    <view class="topic-card" wx:for="{{topics}}" wx:key="_id" bindtap="onTopicTap" data-id="{{item._id}}">
        <view class="topic-top">
          <view class="topic-title-wrap">
            <text class="topic-title">{{item.title}}</text>
            <text class="topic-status status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <text class="topic-desc">{{item.description}}</text>
        </view>
        <view class="topic-bottom">
          <view class="topic-author">
            <image class="author-avatar" src="{{item.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
            <view class="author-info">
              <text class="author-name">{{item.author}}</text>
              <text class="topic-time">{{item.createTime}}</text>
            </view>
          </view>
          <view class="topic-stats">
            <text class="iconfont icon-pinglun stat-icon"></text>
            <text class="stat-num">{{item.commentCount || 0}}</text>
          </view>
        </view>
      </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{topics.length === 0}}">
    <text class="iconfont icon-pinglun icon-xxxl"></text>
    <text class="empty-text">暂无议事议题</text>
    <text class="empty-hint">点击右下角发起第一个议题吧</text>
  </view>

  <!-- 发布按钮 -->
  <view class="fab-btn" bindtap="onPublishTap">
    <text class="iconfont icon-fabuxiangmu icon-xxxl"></text>
  </view>

</view>

<!-- 发起议题半屏弹窗 -->
<mp-half-screen-dialog
  ext-class="publish-dialog"
  show="{{showPublishDialog}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onClosePublishDialog"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">发起议题</text>
    <view class="dialog-submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">
      <text>{{submitting ? '发布中' : '发起'}}</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <!-- 议题内容 -->
    <view class="form-section">
      <textarea class="form-textarea" placeholder="请输入议题内容..." value="{{publishForm.content}}" bindinput="onContentInput" maxlength="200" auto-height></textarea>
      <text class="form-count">{{publishForm.content.length || 0}}/200</text>
    </view>
  </view>
</mp-half-screen-dialog>
