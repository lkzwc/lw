/* pages/discuss/discuss.wxss - 业主议事厅列表版 */

.discuss-page {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
}

.nav-placeholder {
  width: 100%;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--spacing-md);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-right {
  width: 72rpx;
}

/* ========== 页面标题区 ========== */
.page-header {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  padding: 0 var(--spacing-lg) var(--spacing-lg);
  border-radius: 0 0 32rpx 32rpx;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 议题列表 ========== */
.topic-list {
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.topic-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.topic-top {
  margin-bottom: var(--spacing-sm);
}

.topic-title-wrap {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.topic-title {
  flex: 1;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-status {
  flex-shrink: 0;
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-left: var(--spacing-sm);
}

.status-discussing {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.status-voting {
  background: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.status-resolved {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.topic-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

.topic-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.topic-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: var(--font-xs);
  color: var(--text-primary);
  font-weight: 500;
}

.topic-time {
  font-size: 20rpx;
  color: var(--text-placeholder);
}

.topic-stats {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

.stat-num {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx var(--spacing-lg);
}

.empty-icon-font {
  font-size: 80rpx;
  color: var(--text-placeholder);
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* ========== 发布按钮 ========== */
.publish-btn {
  position: fixed;
  right: var(--spacing-md);
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.publish-btn:active {
  transform: scale(0.94);
}

.publish-icon-font {
  font-size: 44rpx;
  color: #FFFFFF;
}

/* ========== 发布弹窗 ========== */
.dialog-body {
  overflow-x: hidden;
  padding: 0 8rpx;
}

.form-section {
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}
