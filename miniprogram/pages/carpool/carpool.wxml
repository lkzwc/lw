<!--pages/carpool/carpool.wxml - 按设计图重构-->
<view class="carpool-page">
  
  <!-- 顶部标题栏 -->
  <view class="page-header">
    <view class="nav-back-btn" bindtap="onBackTap">
      <text class="back-icon">‹</text>
    </view>
    <text class="page-title">牛马专线</text>
    <text class="page-subtitle">邻里互助，出行更便捷</text>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="all">全部</view>
    <view class="filter-tab {{currentFilter === 'long' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="long">长期路线</view>
    <view class="filter-tab {{currentFilter === 'once' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="once">临时路线</view>
  </view>

  <!-- 路线列表 -->
  <view class="route-list">
    <view class="route-card" wx:for="{{routes}}" wx:key="_id" bindtap="onRouteTap" data-id="{{item._id}}">
      <view class="route-header">
        <view class="route-type type-{{item.type}}">{{item.type === 'long' ? '长期' : '临时'}}</view>
        <text class="route-seats">余{{item.seats}}座</text>
      </view>
      
      <view class="route-path">
        <view class="path-point">
          <view class="point-dot start"></view>
          <text class="point-text">{{item.start}}</text>
        </view>
        <view class="path-line"></view>
        <view class="path-point">
          <view class="point-dot end"></view>
          <text class="point-text">{{item.end}}</text>
        </view>
      </view>
      
      <view class="route-footer">
        <view class="route-time">
          <text class="time-icon">⏰</text>
          <text class="time-text">{{item.timeStr}}</text>
        </view>
        <view class="route-contact" catchtap="onCallTap" data-phone="{{item.phone}}">
          <text class="contact-icon">📞</text>
          <text class="contact-text">联系车主</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{routes.length === 0}}">
    <text class="empty-icon">🚗</text>
    <text class="empty-text">暂无拼车路线</text>
    <text class="empty-hint">点击右下角发布第一条路线吧</text>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-btn" bindtap="onPublishTap">
    <text class="publish-icon">+</text>
    <text class="publish-text">发布路线</text>
  </view>

</view>

<!-- 发布路线半屏弹窗 -->
<mp-half-screen-dialog
  ext-class="publish-dialog"
  show="{{showPublishDialog}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onClosePublishDialog"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">发布路线</text>
    <view class="dialog-submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">
      <text>{{submitting ? '发布中' : '发布'}}</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <!-- 路线类型 -->
    <view class="form-section">
      <view class="form-label">路线类型</view>
      <view class="type-selector">
        <view class="type-option {{publishForm.type === 'long' ? 'active' : ''}}" bindtap="onTypeChange" data-type="long">
          <text class="type-icon">🔄</text>
          <text class="type-text">长期</text>
        </view>
        <view class="type-option {{publishForm.type === 'once' ? 'active' : ''}}" bindtap="onTypeChange" data-type="once">
          <text class="type-icon">📍</text>
          <text class="type-text">单次</text>
        </view>
      </view>
    </view>
    
    <!-- 出发地 -->
    <view class="form-section">
      <view class="form-label">出发地 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入出发地点" value="{{publishForm.start}}" bindinput="onStartInput" />
    </view>
    
    <!-- 目的地 -->
    <view class="form-section">
      <view class="form-label">目的地 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入目的地点" value="{{publishForm.end}}" bindinput="onEndInput" />
    </view>
    
    <!-- 出发时间 -->
    <view class="form-section" wx:if="{{publishForm.type === 'once'}}">
      <view class="form-label">出发时间 <text class="required">*</text></view>
      <picker mode="multiSelector" range="{{timeRange}}" value="{{timeIndex}}" bindchange="onTimeChange">
        <view class="form-picker">
          <text class="{{publishForm.timeStr ? '' : 'placeholder'}}">{{publishForm.timeStr || '请选择出发时间'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    
    <!-- 行驶时间（长期） -->
    <view class="form-section" wx:if="{{publishForm.type === 'long'}}">
      <view class="form-label">行驶时间 <text class="required">*</text></view>
      <input class="form-input" placeholder="如：工作日 8:00" value="{{publishForm.schedule}}" bindinput="onScheduleInput" />
    </view>
    
    <!-- 座位数 -->
    <view class="form-section">
      <view class="form-label">剩余座位</view>
      <view class="seat-selector">
        <view class="seat-btn" bindtap="onSeatMinus">-</view>
        <text class="seat-value">{{publishForm.seats}}</text>
        <view class="seat-btn" bindtap="onSeatPlus">+</view>
      </view>
    </view>
    
    <!-- 联系电话 -->
    <view class="form-section">
      <view class="form-label">联系电话 <text class="required">*</text></view>
      <input class="form-input" type="number" placeholder="请输入联系电话" value="{{publishForm.phone}}" bindinput="onPhoneInput" />
    </view>
  </view>
</mp-half-screen-dialog>