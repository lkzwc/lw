/* pages/carpool/carpool.wxss - 统一暖橙色主题 */

.carpool-page {
  
  
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  overflow: hidden;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
}

.nav-placeholder {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--spacing-md);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-right {
  width: 72rpx;
}

/* 页面标题区 */
.page-header {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  padding: 0 var(--spacing-lg) var(--spacing-lg);
  border-radius: 0 0 40rpx 40rpx;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  padding: var(--spacing-md);
  gap: var(--spacing-sm);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  font-weight: 500;
}

/* 路线列表 */
.route-list {
  padding: 0 var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.route-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.route-type {
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.type-long {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.type-once {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.route-seats {
  font-size: var(--font-sm);
  color: #52C41A;
  font-weight: 500;
}

/* 路线路径 */
.route-path {
  padding: var(--spacing-sm) 0;
}

.path-point {
  display: flex;
  align-items: center;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: var(--spacing-sm);
}

.point-dot.start {
  background: #52C41A;
}

.point-dot.end {
  background: #4A90D9;
}

.point-text {
  font-size: var(--font-base);
  color: var(--text-primary);
  font-weight: 500;
}

.path-line {
  width: 2rpx;
  height: 32rpx;
  background: #E8E8E8;
  margin: 8rpx 0 8rpx 7rpx;
}

/* 路线底部 */
.route-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.route-time {
  display: flex;
  align-items: center;
}

.time-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.time-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.route-contact {
  display: flex;
  align-items: center;
  background: rgba(74, 144, 217, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.contact-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.contact-text {
  font-size: var(--font-sm);
  color: #4A90D9;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx var(--spacing-lg);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: var(--spacing-md);
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.publish-icon {
  font-size: var(--font-lg);
  color: #FFFFFF;
  margin-right: 8rpx;
}

.publish-text {
  font-size: var(--font-base);
  color: #FFFFFF;
  font-weight: 500;
}

/* ========== 发布弹窗 ========== */
.dialog-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dialog-submit-btn {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-weight: 500;
}

.dialog-submit-btn.disabled {
  opacity: 0.5;
}

.dialog-body {
  padding: 0 8rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.required {
  color: #FF4D4F;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.form-picker .placeholder {
  color: var(--text-placeholder);
}

.picker-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-option.active {
  background: rgba(74, 144, 217, 0.1);
  border-color: var(--primary-color);
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.type-option.active .type-text {
  color: var(--primary-color);
  font-weight: 500;
}

/* 座位选择器 */
.seat-selector {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.seat-btn {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
}

.seat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}