/* pages/carpool/carpool.wxss - 统一暖橙色主题 */

.carpool-page {
  overflow-x: hidden;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 页面标题区 */
.page-header {
  background: var(--gradient-primary);
  padding: 0 var(--spacing-lg) var(--spacing-md);
  border-radius: 0 0 40rpx 40rpx;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  padding: var(--spacing-sm);
  gap: var(--spacing-xs);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.filter-tab.active {
  background: var(--gradient-primary);
  color: #FFFFFF;
  font-weight: 500;
}

/* 路线列表 */
.route-list {
  padding: 0 var(--spacing-sm);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.route-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: var(--spacing-sm);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.route-type {
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.type-long {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.type-once {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.route-seats {
  font-size: var(--font-sm);
  color: #52C41A;
  font-weight: 500;
}

/* 路线路径 */
.route-path {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  gap: 12rpx;
}

.path-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.path-arrow {
  flex-shrink: 0;
}

/* 路线底部 */
.route-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8rpx;
  border-top: 1rpx solid #F0F0F0;
}

.route-time {
  display: flex;
  align-items: center;
}

.route-contact {
  display: flex;
  align-items: center;
  background: rgba(74, 144, 217, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.contact-text {
  font-size: var(--font-sm);
  color: #4A90D9;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx var(--spacing-lg);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}
/* ========== 发布弹窗 - 按钮样式继承全局 app.wxss ========== */

.dialog-body {
  overflow-x: hidden;
  padding: 0 8rpx 0;
}

.form-section {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.required {
  color: #FF4D4F;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker .placeholder {
  color: var(--text-placeholder);
}

.picker-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-option.active {
  background: rgba(74, 144, 217, 0.1);
  border-color: var(--primary-color);
}

.type-option.active .iconfont {
  color: #4A90D9;
}

.type-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.type-option.active .type-text {
  color: var(--primary-color);
  font-weight: 500;
}

/* 座位选择器 */
.seat-selector {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.seat-btn {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
}

.seat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}