/* pages/timeline/timeline.wxss - 时间线模式 */

.timeline-page {
  overflow-x: hidden;
  
  
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  overflow: hidden;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
}

.nav-placeholder {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--spacing-md);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-right {
  width: 72rpx;
}

/* ========== 页面标题区 ========== */
.page-header {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  padding: 0 var(--spacing-lg) var(--spacing-lg);
  border-radius: 0 0 32rpx 32rpx;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 筛选标签 ========== */
.filter-tabs {
  display: flex;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: #FFFFFF;
  margin: var(--spacing-md);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: var(--spacing-sm) 0;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  
  border-radius: 24rpx;
  transition: all 0.2s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  font-weight: 500;
}

/* ========== 时间线列表 ========== */
.timeline-list {
  padding: 0 var(--spacing-md);
}

.timeline-item {
  display: flex;
  margin-bottom: var(--spacing-md);
}

/* 左侧时间轴 */
.timeline-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  margin-right: var(--spacing-sm);
}

.axis-dot {
  width: 24rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  border-radius: 50%;
  flex-shrink: 0;
}

.axis-line {
  width: 4rpx;
  flex: 1;
  background: #E8E8E8;
  margin-top: 8rpx;
}

.timeline-item:last-child .axis-line {
  display: none;
}

/* 右侧内容卡片 */
.timeline-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-sm);
}

.card-title {
  flex: 1;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.card-status {
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  margin-left: var(--spacing-sm);
}

.status-pending {
  background: rgba(255, 77, 79, 0.1);
  color: #FF4D4F;
}

.status-processing {
  background: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.status-resolved {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.card-desc {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--spacing-sm);
}

/* 图片 */
.card-images {
  display: flex;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.card-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  
}

/* 底部信息 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.footer-date {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.footer-discuss {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.discuss-icon {
  font-size: 24rpx;
}

.discuss-num {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx var(--spacing-lg);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* ========== 发布按钮 ========== */
.publish-btn {
  position: fixed;
  right: var(--spacing-md);
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  padding: var(--spacing-md) var(--spacing-lg);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.publish-icon {
  font-size: 32rpx;
}

.publish-text {
  font-size: var(--font-base);
  font-weight: 600;
  color: #FFFFFF;
}

/* ========== 发布弹窗 ========== */
.dialog-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dialog-submit-btn {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-weight: 500;
}

.dialog-submit-btn.disabled {
  opacity: 0.5;
}

.dialog-body {
  overflow-x: hidden;
  padding: 0 8rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.required {
  color: #FF4D4F;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-option.active {
  background: rgba(74, 144, 217, 0.1);
  border-color: var(--primary-color);
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.type-option.active .type-text {
  color: var(--primary-color);
  font-weight: 500;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  overflow: hidden;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D9D9D9;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-placeholder);
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
}