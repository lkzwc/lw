/* pages/activity/activity.wxss - 统一暖橙色主题 */

.activity-page {
  overflow-x: hidden;
  background: #F5F7FA;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 页面标题区 */
.page-header {
  background: var(--gradient-primary);
  padding: 0 var(--spacing-lg) var(--spacing-lg);
  border-radius: 0 0 40rpx 40rpx;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* 日历区域 */
.calendar-section {
  margin: var(--spacing-md);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.calendar-nav {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  font-size: var(--font-lg);
  color: var(--text-secondary);
}

.calendar-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.week-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.week-day {
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  position: relative;
  background: #F7F9FC;
}

.weekday-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-bottom: 8rpx;
}

.week-day.today {
  background: rgba(74, 144, 217, 0.1);
}

.week-day.today .day-text {
  color: #4A90D9;
  font-weight: 600;
}

.week-day.selected {
  background: var(--gradient-primary);
}

.week-day.selected .day-text,
.week-day.selected .weekday-text {
  color: #FFFFFF;
}

.day-text {
  font-size: var(--font-base);
  color: var(--text-primary);
}

.activity-dot {
  width: 8rpx;
  height: 8rpx;
  background: #4A90D9;
  border-radius: 50%;
  margin-top: 4rpx;
}

.week-day.selected .activity-dot {
  background: #FFFFFF;
}

/* 活动区域 */
.activity-section {
  padding: 0 var(--spacing-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.publish-btn-small {
  background: rgba(74, 144, 217, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: var(--font-sm);
  color: #4A90D9;
  font-weight: 500;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.activity-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.activity-cover {
  width: 100%;
  height: 240rpx;
}

.activity-cover-placeholder {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #E8F0F8 0%, #F0F5FA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-content {
  padding: var(--spacing-md);
}

.activity-status {
  display: inline-block;
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: var(--spacing-sm);
}

.status-ongoing {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.status-upcoming {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.status-ended {

  color: var(--text-placeholder);
}

.activity-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: var(--spacing-sm);
}

.meta-item {
  display: flex;
  align-items: center;
}

.meta-icon {
  font-size: 28rpx;
  color: var(--text-placeholder);
  margin-right: 8rpx;
}

.meta-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.activity-footer {
  display: flex;
  align-items: center;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.join-avatars {
  display: flex;
  margin-right: var(--spacing-sm);
}

.join-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  margin-left: -16rpx;
}

.join-avatar:first-child {
  margin-left: 0;
}

.join-count {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx var(--spacing-lg);
}
/* ========== 发布弹窗 - 按钮样式继承全局 app.wxss ========== */

.dialog-body {
  overflow-x: hidden;
  padding: 0 8rpx 0;
}

.form-section {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.required {
  color: #FF4D4F;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker .placeholder {
  color: var(--text-placeholder);
}

.picker-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

/* 人数选择器 */
.seat-selector {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.seat-btn {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
}

.seat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  background: #F7F9FC;
  border: 2rpx dashed #D0D5DD;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-btn .iconfont {
  color: #4A90D9;
}

.upload-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
}
