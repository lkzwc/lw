<!--pages/activity/activity.wxml - 按设计图重构-->
<view class="activity-page">
  
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight || 0}}px;"></view>
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">活动日历</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 自定义导航栏占位 -->
  <view style="height: {{(statusBarHeight || 0) + 44}}px;"></view>

  <!-- 页面标题区 -->
  <view class="page-header">
    <text class="page-subtitle">发现精彩社区生活</text>
  </view>

  <!-- 日历选择器 -->
  <view class="calendar-section">
    <view class="calendar-header">
      <view class="calendar-nav" bindtap="onPrevMonth">
        <text>‹</text>
      </view>
      <text class="calendar-title">{{currentMonth}}</text>
      <view class="calendar-nav" bindtap="onNextMonth">
        <text>›</text>
      </view>
    </view>
    <view class="calendar-weekdays">
      <text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="calendar-days">
      <view 
        class="calendar-day {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.hasActivity ? 'has-activity' : ''}}"
        wx:for="{{calendarDays}}" 
        wx:key="date"
        bindtap="onDaySelect"
        data-date="{{item.date}}"
      >
        <text class="day-text">{{item.day}}</text>
        <view class="activity-dot" wx:if="{{item.hasActivity}}"></view>
      </view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-section">
    <view class="section-header">
      <text class="section-title">{{selectedDateStr}}的活动</text>
      <view class="publish-btn-small" bindtap="onPublishTap">
        <text>发起活动</text>
      </view>
    </view>
    
    <view class="activity-list">
      <view class="activity-card" wx:for="{{activities}}" wx:key="_id" bindtap="onActivityTap" data-id="{{item._id}}">
        <image class="activity-cover" src="{{item.cover || '/assets/images/default-activity.png'}}" mode="aspectFill"></image>
        <view class="activity-content">
          <view class="activity-status status-{{item.status}}">{{item.statusLabel}}</view>
          <text class="activity-title">{{item.title}}</text>
          <view class="activity-meta">
            <view class="meta-item">
              <text class="meta-icon">📍</text>
              <text class="meta-text">{{item.location}}</text>
            </view>
            <view class="meta-item">
              <text class="meta-icon">⏰</text>
              <text class="meta-text">{{item.time}}</text>
            </view>
          </view>
          <view class="activity-footer">
            <view class="join-avatars">
              <image class="join-avatar" wx:for="{{item.joinAvatars}}" wx:for-item="avatar" wx:key="*this" src="{{avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
            </view>
            <text class="join-count">{{item.joinCount}}人已报名</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{activities.length === 0}}">
      <text class="empty-icon">📅</text>
      <text class="empty-text">当天暂无活动</text>
      <text class="empty-hint">点击右上角发起第一个活动吧</text>
    </view>
  </view>

</view>

<!-- 发起活动半屏弹窗 -->
<mp-half-screen-dialog
  ext-class="publish-dialog"
  show="{{showPublishDialog}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onClosePublishDialog"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">发起活动</text>
    <view class="dialog-submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">
      <text>{{submitting ? '发布中' : '发布'}}</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <!-- 活动标题 -->
    <view class="form-section">
      <view class="form-label">活动标题 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入活动标题" value="{{publishForm.title}}" bindinput="onTitleInput" maxlength="30" />
    </view>
    
    <!-- 活动时间 -->
    <view class="form-section">
      <view class="form-label">活动时间 <text class="required">*</text></view>
      <picker mode="date" value="{{publishForm.date}}" start="{{today}}" bindchange="onDateChange">
        <view class="form-picker">
          <text class="{{publishForm.date ? '' : 'placeholder'}}">{{publishForm.date || '请选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    
    <!-- 活动地点 -->
    <view class="form-section">
      <view class="form-label">活动地点 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入活动地点" value="{{publishForm.location}}" bindinput="onLocationInput" maxlength="50" />
    </view>
    
    <!-- 活动描述 -->
    <view class="form-section">
      <view class="form-label">活动描述</view>
      <textarea class="form-textarea" placeholder="请描述活动内容..." value="{{publishForm.desc}}" bindinput="onDescInput" maxlength="200" auto-height></textarea>
      <text class="form-count">{{publishForm.desc.length || 0}}/200</text>
    </view>
    
    <!-- 活动人数 -->
    <view class="form-section">
      <view class="form-label">人数限制</view>
      <view class="seat-selector">
        <view class="seat-btn" bindtap="onCountMinus">-</view>
        <text class="seat-value">{{publishForm.maxCount}}</text>
        <view class="seat-btn" bindtap="onCountPlus">+</view>
      </view>
    </view>
  </view>
</mp-half-screen-dialog>