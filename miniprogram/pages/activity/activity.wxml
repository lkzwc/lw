<!--pages/activity/activity.wxml - 按设计图重构-->
<view class="activity-page">

  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight || 0}}px;"></view>
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">活动日历</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 自定义导航栏占位 -->
  <view style="height: {{(statusBarHeight || 0) + 44}}px;"></view>

  <!-- 页面标题区 -->
  <view class="page-header">
    <text class="page-subtitle">发现精彩社区生活</text>
  </view>

  <!-- 周日历 -->
  <view class="calendar-section">
    <view class="calendar-header">
      <view class="calendar-nav" bindtap="onPrevWeek">
        <text>‹</text>
      </view>
      <text class="calendar-title">{{weekTitle}}</text>
      <view class="calendar-nav" bindtap="onNextWeek">
        <text>›</text>
      </view>
    </view>
    <view class="week-days">
      <view
        class="week-day {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.hasActivity ? 'has-activity' : ''}}"
        wx:for="{{weekDays}}"
        wx:key="date"
        bindtap="onDayTap"
        data-date="{{item.date}}"
      >
        <text class="weekday-text">周{{item.weekday}}</text>
        <text class="day-text">{{item.day}}</text>
        <view class="activity-dot" wx:if="{{item.hasActivity}}"></view>
      </view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-section">
    <view class="section-header">
      <text class="section-title">{{selectedDateStr}}的活动</text>
      <view class="publish-btn-small" bindtap="onPublishTap">
        <text>发起活动</text>
      </view>
    </view>

    <view class="activity-list">
      <view class="activity-card" wx:for="{{activities}}" wx:key="_id" bindtap="onActivityTap" data-id="{{item._id}}">
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}"></image>
        <view class="activity-cover-placeholder" wx:else>
          <text class="iconfont icon-rili icon-xxxl"></text>
        </view>
        <view class="activity-content">
          <view class="activity-status status-{{item.status}}">{{item.statusLabel}}</view>
          <text class="activity-title">{{item.title}}</text>
          <view class="activity-meta">
            <view class="meta-item">
              <text class="meta-icon iconfont icon-dingwei"></text>
              <text class="meta-text">{{item.location}}</text>
            </view>
            <view class="meta-item">
              <text class="iconfont icon-naozhong_huaban1 meta-icon"></text>
              <text class="meta-text">{{item.time}}</text>
            </view>
          </view>
          <view class="activity-footer">
            <view class="join-avatars">
              <image class="join-avatar" wx:for="{{item.joinAvatars}}" wx:for-item="avatar" wx:key="*this" src="{{avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
            </view>
            <text class="join-count">{{item.joinCount}}人已报名</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{activities.length === 0}}">
    <text class="iconfont icon-rili icon-huge"></text>
      <text class="empty-text">当天暂无活动</text>
      <text class="empty-hint">点击右上角发起第一个活动吧</text>
    </view>
  </view>

</view>

<!-- 发起活动半屏弹窗 -->
<mp-half-screen-dialog
  ext-class="publish-dialog"
  show="{{showPublishDialog}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onClosePublishDialog"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">发起活动</text>
    <view class="dialog-submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">
      <text>{{submitting ? '发布中' : '发布'}}</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <!-- 活动标题 -->
    <view class="form-section">
      <input class="form-input" placeholder="活动标题（必填）" value="{{publishForm.title}}" bindinput="onTitleInput" maxlength="30" />
    </view>

    <!-- 活动时间 -->
    <view class="form-section">
      <picker mode="date" value="{{publishForm.date}}" start="{{today}}" bindchange="onDateChange">
        <view class="form-picker">
          <text class="{{publishForm.date ? '' : 'placeholder'}}">{{publishForm.date || '活动时间（必填）'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 活动地点 -->
    <view class="form-section">
      <input class="form-input" placeholder="活动地点（必填）" value="{{publishForm.location}}" bindinput="onLocationInput" maxlength="50" />
    </view>

    <!-- 活动描述 -->
    <view class="form-section">
      <textarea class="form-textarea" placeholder="活动描述" value="{{publishForm.desc}}" bindinput="onDescInput" maxlength="200" auto-height></textarea>
      <text class="form-count">{{publishForm.desc.length || 0}}/200</text>
    </view>

    <!-- 活动人数 -->
    <view class="form-section">
      <view class="seat-selector">
        <view class="seat-btn" bindtap="onCountMinus">-</view>
        <text class="seat-value">人数限制 {{publishForm.maxCount}}</text>
        <view class="seat-btn" bindtap="onCountPlus">+</view>
      </view>
    </view>

    <!-- 图片上传 -->
    <view class="form-section">
      <view class="image-upload">
        <view class="image-item" wx:for="{{publishForm.images}}" wx:key="*this">
          <image class="image-preview" src="{{item}}" mode="aspectFill"></image>
          <view class="image-delete" catchtap="onDeleteImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="onChooseImage" wx:if="{{publishForm.images.length < 3}}">
          <text class="iconfont icon-tianjia icon-xl"></text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </view>
  </view>
</mp-half-screen-dialog>
