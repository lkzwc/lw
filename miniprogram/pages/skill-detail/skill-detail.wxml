<!--pages/skill-detail/skill-detail.wxml-->
<view class="skill-detail-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight || 0}}px;"></view>
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">技能详情</text>
      <view class="nav-right"></view>
    </view>
  </view>
  <view style="height: {{(statusBarHeight || 0) + 44}}px;"></view>

  <!-- 技能信息 -->
  <view class="skill-card" wx:if="{{skill}}">
    <!-- 头部：左标题 右报价 -->
    <view class="skill-header">
      <view class="skill-title">{{skill.title}}</view>
      <view class="skill-price">{{skill.price}}</view>
    </view>

    <!-- 用户信息 -->
    <view class="skill-user-info">
      <image class="avatar" src="{{skill.userInfo.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="user-name">{{skill.userInfo.nickName || '匿名用户'}}</text>
        <text class="post-time">{{skill.createTimeStr}}</text>
      </view>
    </view>

    <!-- 描述 -->
    <view class="skill-desc" wx:if="{{skill.description}}">
      <view class="desc-label">详细描述</view>
      <text class="desc-content">{{skill.description}}</text>
    </view>

    <!-- 图片 -->
    <view class="skill-images" wx:if="{{skill.images && skill.images.length > 0}}">
      <view class="images-label">作品展示</view>
      <view class="image-grid">
        <image 
          wx:for="{{skill.images}}" 
          wx:key="*this" 
          src="{{item}}" 
          mode="aspectFill"
          bindtap="onPreviewImage"
          data-url="{{item}}"
          data-urls="{{skill.images}}"
        ></image>
      </view>
    </view>

    <!-- 浏览量 + 点赞数 -->
    <view class="skill-stats">
      <text class="stat-item"><text class="iconfont icon-liulan stat-icon-inline"></text> {{skill.viewCount || 0}} 次浏览</text>
      <text class="stat-item"><text class="iconfont icon-aixin stat-icon-inline liked"></text> {{skill.likeCount || 0}} 人点赞</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <!-- 点赞按钮 -->
    <view class="like-btn {{isLiked ? 'liked' : ''}}" bindtap="onLike">
      <text class="iconfont {{isLiked ? 'icon-aixin icon-lg' : 'icon-aixin icon-lg'}}"></text>
      <text class="like-count">{{skill.likeCount || 0}}</text>
    </view>
    <button class="contact-btn" bindtap="onCallPhone">
      <text class="iconfont icon-dianhua icon-lg"></text>
      <text>拨打电话</text>
    </button>
  </view>
</view>

<!-- 加载状态 -->
<loading wx:if="{{loading}}"></loading>
