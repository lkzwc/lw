<!--pages/index/index.wxml - 高科麓湾未来感首页-->
<view class="index-page">
  
  <!-- 顶部Hero区域 -->
  <view class="hero-section">
    <!-- 背景图 -->
    <image class="hero-bg" src="/assets/images/homebg.jpeg" mode="aspectFill"></image>
    
    <!-- 内容层 -->
    <view class="hero-content">
      <!-- 项目名称 -->
      <view class="hero-title-area">
        <text class="hero-title">高科麓湾</text>
        <text class="hero-subtitle">美好社区 智慧生活</text>
      </view>
      
      <!-- 天气卡片（毛玻璃效果） -->
      <view class="weather-card">
        <view class="weather-main">
          <text class="weather-icon">{{weather.icon}}</text>
          <view class="weather-temp-area">
            <text class="weather-temp">{{weather.temp}}</text>
            <text class="weather-unit">°C</text>
          </view>
        </view>
        <view class="weather-detail">
          <text class="weather-desc">{{weather.desc}}</text>
          <text class="weather-air">空气 {{weather.airQuality}}</text>
        </view>
      </view>
      
    </view>
  </view>

  <!-- 快捷入口卡片 -->
  <view class="quick-menu-card">
    <!-- 第一行 -->
    <view class="menu-row">
      <view class="menu-item" wx:for="{{row1Menus}}" wx:key="id" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon-wrap">
          <text class="iconfont {{item.icon}}"></text>
        </view>
        <text class="menu-name">{{item.name}}</text>
      </view>
    </view>
    
    <!-- 第二行 -->
    <view class="menu-row">
      <view class="menu-item" wx:for="{{row2Menus}}" wx:key="id" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon-wrap">
          <text class="iconfont {{item.icon}}"></text>
        </view>
        <text class="menu-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 公告模块 -->
  <view class="notice-card" wx:if="{{notice}}">
    <view class="notice-tag">公告</view>
    <swiper class="notice-swiper" autoplay circular vertical>
      <swiper-item>
        <text class="notice-text">{{notice.title}}</text>
      </swiper-item>
    </swiper>
    <text class="notice-arrow">›</text>
  </view>

  <!-- 最新技能（小红书风格） -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">最新技能</text>
      <view class="section-more" bindtap="onSkillMore">
        <text>更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>
    <scroll-view class="skill-scroll" scroll-x>
      <view class="skill-list">
        <view class="skill-card" wx:for="{{skills}}" wx:key="_id" bindtap="onSkillTap" data-id="{{item._id}}">
          <image class="skill-cover" src="{{item.cover || ''}}" mode="aspectFill"></image>
          <view class="skill-info">
            <text class="skill-title">{{item.title}}</text>
            <view class="skill-meta">
              <image class="skill-avatar" src="{{item.avatar || ''}}" mode="aspectFill"></image>
              <text class="skill-author">{{item.author}}</text>
            </view>
            <view class="skill-stats">
              <text class="skill-likes">❤️ {{item.likes}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 活动日历（Apple风格） -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">活动日历</text>
      <view class="section-more" bindtap="onActivityMore">
        <text>更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>
    <view class="activity-list">
      <view class="activity-card" wx:for="{{activities}}" wx:key="_id" bindtap="onActivityTap" data-id="{{item._id}}">
        <image class="activity-cover" src="{{item.cover || ''}}" mode="aspectFill"></image>
        <view class="activity-content">
          <view class="activity-date-area">
            <text class="activity-month">{{item.month}}</text>
            <text class="activity-day">{{item.day}}</text>
          </view>
          <view class="activity-info">
            <text class="activity-title">{{item.title}}</text>
            <text class="activity-location">📍 {{item.location}}</text>
            <text class="activity-time">🕐 {{item.timeStr}}</text>
          </view>
          <view class="activity-action">
            <view class="join-btn {{item.isJoined ? 'joined' : ''}}">
              <text>{{item.isJoined ? '已报名' : '报名'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>