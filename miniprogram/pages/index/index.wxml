<!--pages/index/index.wxml - 高科麓湾未来感首页-->
<view class="index-page">
  
  <!-- 顶部Hero区域 -->
  <view class="hero-section">
    <!-- 背景图 -->
    <image class="hero-bg" src="/assets/images/homebg.jpeg" mode="aspectFill"></image>
    
    <!-- 内容层 -->
    <view class="hero-content">
      <!-- 项目名称 -->
      <view class="hero-title-area">
        <text class="hero-title">高科麓湾</text>
        <text class="hero-subtitle">美好社区 智慧生活</text>
      </view>
      
      <!-- 天气卡片（毛玻璃效果） -->
      <view class="weather-card">
        <view class="weather-main">
          <text class="weather-icon">{{weather.icon}}</text>
          <view class="weather-temp-area">
            <text class="weather-temp">{{weather.temp}}</text>
            <text class="weather-unit">°C</text>
          </view>
        </view>
        <view class="weather-detail">
          <text class="weather-desc">{{weather.desc}}</text>
          <text class="weather-air">空气 {{weather.airQuality}}</text>
        </view>
      </view>
      
    </view>
  </view>

  <!-- 快捷入口卡片 -->
  <view class="quick-menu-card">
    <!-- 第一行 -->
    <view class="menu-row">
      <view class="menu-item" wx:for="{{row1Menus}}" wx:key="id" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon-wrap">
          <text class="iconfont {{item.icon}} icon-xl"></text>
        </view>
        <text class="menu-name">{{item.name}}</text>
      </view>
    </view>
    
    <!-- 第二行 -->
    <view class="menu-row">
      <view class="menu-item" wx:for="{{row2Menus}}" wx:key="id" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon-wrap">
          <text class="iconfont {{item.icon}} icon-xl"></text>
        </view>
        <text class="menu-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 公告模块 - 卡片列表 -->
  <view class="notice-section" wx:if="{{notices.length > 0}}">
    <view class="section-card">
      <view class="section-header">
        <view class="notice-header-left">
          <text class="iconfont icon-gonggao icon-lg notice-icon-font"></text>
          <text class="section-title">社区公告</text>
        </view>
      </view>
      <view class="notice-list">
        <view class="notice-item" wx:for="{{notices}}" wx:key="_id" bindtap="onNoticeTap" data-id="{{item._id}}">
          <view class="notice-item-tag" wx:if="{{item.category}}">{{item.category}}</view>
          <text class="notice-item-title">{{item.title}}</text>
          <text class="notice-item-date">{{item.dateStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 最新技能（小红书风格） -->
  <view class="section-card">
    <view class="section-header">
      <view>
        <text class="iconfont icon-jinengliang-xian icon-lg notice-icon-font"></text>
      <text class="section-title">最新技能</text>
      </view>
      <view class="section-more" bindtap="onSkillMore">
        <text>更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>
    <scroll-view class="skill-scroll" scroll-x>
      <view class="skill-list">
        <view class="skill-card" wx:for="{{skills}}" wx:key="_id" bindtap="onSkillTap" data-id="{{item._id}}">
          <image class="skill-cover" src="{{item.cover}}" mode="aspectFill" lazy-load wx:if="{{item.cover}}"></image>
          <view class="skill-cover-placeholder" wx:else>
            <text class="iconfont icon-gongju skill-placeholder-icon"></text>
          </view>
          <view class="skill-info">
            <view class="skill-title-row">
              <text class="skill-title">{{item.title}}</text>
              <text class="skill-likes"><text class="iconfont icon-aixin"></text> {{item.likes}}</text>
            </view>
            <view class="skill-meta">
              <image class="skill-avatar" src="{{item.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
              <text class="skill-author">{{item.author}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 活动日历（Apple风格） -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="iconfont icon-jiduhuodong icon-md section-title-icon"></text>
        <text class="section-title">活动日历</text>
      </view>
      <view class="section-more" bindtap="onActivityMore">
        <text>更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>
    <view class="activity-list">
      <view class="activity-card" wx:for="{{activities}}" wx:key="_id" bindtap="onActivityTap" data-id="{{item._id}}">
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}"></image>
        <view class="activity-cover-placeholder-sm" wx:else>
          <text class="iconfont icon-rili home-placeholder-icon"></text>
        </view>
        <view class="activity-content">
          <view class="activity-info">
            <view class="activity-title-row">
              <text class="iconfont icon-jiduhuodong icon-xs activity-icon"></text>
              <text class="activity-title">{{item.title}}</text>
            </view>
            <text class="activity-location"><text class="iconfont icon-dingwei icon-xs"></text> {{item.location}}</text>
            <text class="activity-time"><text class="iconfont icon-naozhong_huaban1 icon-xs"></text> {{item.timeStr}}</text>
          </view>
          <view class="activity-action">
            <view class="join-btn {{item.isJoined ? 'joined' : ''}}">
              <text>{{item.isJoined ? '已报名' : '报名'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>