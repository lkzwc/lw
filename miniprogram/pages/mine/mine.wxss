/* pages/mine/mine.wxss */

.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ========== 区域一：背景区（头像 + 文字 + 按钮） ========== */
.hero-zone {
  position: relative;
  /* max-height: 300rpx; */
  overflow: hidden;
}

.hero-zone-guest {
  min-height: 640rpx;
  padding-bottom: 40rpx;
}

.hero-bg {
  position: absolute;
  inset: 0;
  border-radius: 0rpx 0rpx 110rpx 110rpx;
  background:
    radial-gradient(ellipse 70% 50% at 30% 30%, rgba(138, 79, 255, 0.35) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 75% 65%, rgba(255, 107, 53, 0.2) 0%, transparent 50%),
    linear-gradient(160deg, #0d0d24 0%, #16123a 30%, #1f1454 60%, #2b1666 100%);
  z-index: 0;
}


.status-bar {
  height: calc(88rpx + env(safe-area-inset-top));
  position: relative;
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0rpx 0rpx 90rpx;
}

/* 头像（未登录） */
.avatar-guest {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 40rpx rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.avatar-guest .iconfont {
  font-size: 80rpx;
}

/* 粒子装饰 */
.particle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  animation: float 4s ease-in-out infinite;
}

.p1 { width: 12rpx; height: 12rpx; background: rgba(255,255,255,0.5); top: 120rpx; right: 60rpx; }
.p2 { width: 8rpx; height: 8rpx; background: rgba(255,255,255,0.35); top: 200rpx; left: 70rpx; animation-delay: 1.2s; }

@keyframes float {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-16rpx); opacity: 0.8; }
}

/* 品牌文字行 */
.brand-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.welcome-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 300;
  letter-spacing: 4rpx;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 8rpx;
}

/* 登录按钮（在背景区内部） */
.hero-login-btn {
  width: calc(100% - 96rpx);
  height: 96rpx;
  margin-top: 48rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-login-btn::after {
  border: none;
}

/* 已登录横向布局 */
.user-row-logged {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 48rpx 0 100rpx;
}

.avatar-wrap {
  position: relative;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  background: #FFFFFF;
  color: #4A90D9;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.user-info {
  flex: 1;
  margin-bottom: :20rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.user-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.u-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.18);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

/* ========== 统计卡片 ========== */
.stats-card {
  display: flex;
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 40rpx;
  padding: 28rpx 16rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: #F0F0F0;
}

.stat-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.2;
}

.stat-key {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ========== 区域二：菜单 ========== */
.menu-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border: none;
  border-bottom: none;
}

.menu-item:active {
  background: #FAFAFA;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #F5F7FA;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-icon-wrap.admin {
  background: #FFF3E0;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ========== 退出 ========== */
.logout-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.logout-card:active {
  opacity: 0.8;
}

.logout-text {
  font-size: 30rpx;
  color: #FF4757;
  font-weight: 500;
}

/* ========== 弹窗 ========== */
.dialog-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.dialog-body {
  padding: 16rpx 0 0;
  overflow-x: hidden;
}

.form-row {
  display: block;
  padding: 0;
  border-bottom: none;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 32rpx;
  color: #000000;
}

.form-input {
  text-align: left;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 8rpx;
}

.avatar-picker {
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F7F9FC;
  padding: 0 28rpx;
  border-radius: 18rpx;
  border: none;
  box-sizing: border-box;
  margin: 0;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
}

.avatar-picker-text {
  font-size: 28rpx;
  color: #4A90D9;
  font-weight: 500;
}
