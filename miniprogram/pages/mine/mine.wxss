/* pages/mine/mine.wxss */

.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* ========== 渐变头部 ========== */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background: linear-gradient(160deg, #4A90D9 0%, #6BA8E8 60%, #8EC5F5 100%);
  z-index: 0;
}

.header-wave {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  right: 0;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 40rpx 40rpx 0 0;
}

/* 状态栏占位 */
.status-bar {
  height: calc(88rpx + env(safe-area-inset-top));
  position: relative;
  z-index: 1;
}

/* ========== 用户区域 ========== */
.user-section {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx 0;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.avatar-guest {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 56rpx;
  opacity: 0.7;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: -4rpx;
  background: #FFFFFF;
  color: #4A90D9;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.user-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.u-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.edit-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ========== 登录按钮 ========== */
.login-area {
  position: relative;
  z-index: 1;
  padding: 40rpx 48rpx 0;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  animation: breathe 2.5s ease-in-out infinite;
}

.login-btn::after {
  border: none;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12); }
  50% { transform: scale(1.03); box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18); }
}

.login-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A90D9;
  letter-spacing: 2rpx;
}

/* ========== 统计卡片 ========== */
.stats-card {
  display: flex;
  background: #FFFFFF;
  margin: 32rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 36rpx 16rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: #F0F0F0;
}

.stat-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.2;
}

.stat-key {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ========== 菜单卡片 ========== */
.menu-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #FAFAFA;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #F5F7FA;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-icon-wrap .iconfont {
  font-size: 32rpx;
  color: #4A90D9;
}

.menu-icon-wrap.admin {
  background: #FFF3E0;
}

.menu-icon-wrap.admin .iconfont {
  color: #FF9800;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ========== 退出 ========== */
.logout-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.logout-card:active {
  opacity: 0.8;
}

.logout-text {
  font-size: 30rpx;
  color: #FF4757;
  font-weight: 500;
}

/* ========== 弹窗 ========== */
.dialog-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.dialog-submit-btn {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.dialog-submit-btn.disabled {
  background: #E8E8E8;
  color: #999;
}

.dialog-body {
  padding: 16rpx 0 0;
  overflow-x: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 32rpx;
  color: #000000;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  text-align: right;
}

.form-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.picker-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 8rpx;
}

.avatar-picker {
  background: transparent;
  padding: 0;
  border: none;
  margin-left: auto;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #F0F0F0;
}