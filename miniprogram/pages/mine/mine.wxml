<!--pages/mine/mine.wxml-->
<view class="page">
  <!-- ========== 区域一：背景 + 头像 + 登录 ========== -->
  <view class="hero-zone {{isLoggedIn ? '' : 'hero-zone-guest'}}">
    <view class="hero-bg"></view>
    <!-- 内容 -->
    <view class="hero-content {{isLoggedIn ? 'hero-content-login' : ''}}">
      <!-- 未登录 -->
      <block wx:if="{{!isLoggedIn}}">
        <view class="avatar-guest">
          <text class="iconfont icon-wode icon-xxxl"></text>
        </view>
        <view class="particle p1"></view>
        <view class="particle p2"></view>
        <view class="brand-row">
          <text class="welcome-text">Hi，欢迎回家</text>
          <text class="brand-name">麓家</text>
        </view>
        <button class="hero-login-btn" bindtap="onLogin">开启邻里生活</button>
      </block>

      <!-- 已登录 -->
      <view class="user-row-logged" wx:else>
        <view class="avatar-wrap" bindtap="onEditTap">
          <image class="avatar-img" src="{{userInfo.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-badge">编辑</view>
        </view>
        <view class="user-info">
          <text class="user-name">{{userInfo.nickName || '设置昵称'}}</text>
          <view class="user-tags" wx:if="{{userInfo.phase || userInfo.building}}">
            <text class="u-tag" wx:if="{{userInfo.phase}}">{{userInfo.phase}}</text>
            <text class="u-tag" wx:if="{{userInfo.building}}">{{userInfo.building}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据统计（已登录） -->
  <view class="stats-card" wx:if="{{isLoggedIn}}">
    <view class="stat" bindtap="onMyPostsTap">
      <text class="stat-val">{{stats.postCount || 0}}</text>
      <text class="stat-key">发布</text>
    </view>
    <view class="stat" bindtap="onMyLikesTap">
      <text class="stat-val">{{stats.likeCount || 0}}</text>
      <text class="stat-key">点赞</text>
    </view>
    <view class="stat" bindtap="onMySkillsTap">
      <text class="stat-val">{{stats.skillCount || 0}}</text>
      <text class="stat-key">技能</text>
    </view>
    <view class="stat" bindtap="onMyCarpoolsTap">
      <text class="stat-val">{{stats.carpoolCount || 0}}</text>
      <text class="stat-key">捎一段</text>
    </view>
  </view>

  <!-- ========== 区域二：功能菜单 ========== -->
  <view class="menu-card">
    <view class="menu-item" bindtap="onContactTap">
      <view class="menu-icon-wrap"><text class="iconfont icon-kefu icon-md icon-lg"></text></view>
      <text class="menu-name">联系开发者</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAboutTap">
      <view class="menu-icon-wrap"><text class="iconfont icon-bangzhuzhongxin icon-md icon-lg"></text></view>
      <text class="menu-name">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="onAdminTap">
      <view class="menu-icon-wrap admin"><text class="iconfont icon-shouye icon-md icon-lg"></text></view>
      <text class="menu-name">管理后台</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出 -->
  <view class="logout-card" wx:if="{{isLoggedIn}}" bindtap="onLogout">
    <text class="logout-text">退出登录</text>
  </view>
</view>

<!-- 编辑弹窗 -->
<mp-half-screen-dialog
  ext-class="profile-dialog"
  show="{{showEditDialog}}"
  maskClosable
  closable
  bindclose="onCloseEditDialog"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">编辑资料</text>
    <view class="dialog-submit-btn" bindtap="onSaveUserInfo">
      <text>保存</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <view class="form-row">
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatarEdit">
        <image class="avatar-preview" src="{{editForm.avatarUrl || '/assets/icons/avatar.png'}}"></image>
        <text class="avatar-picker-text">更换头像</text>
      </button>
    </view>
    <view class="form-row">
      <input class="form-input" type="nickname" placeholder="昵称" value="{{editForm.nickName}}" bindinput="onNickNameInput" maxlength="20" />
    </view>
    <view class="form-row">
      <picker mode="multiSelector" range="{{phaseBuildingRange}}" value="{{phaseBuildingValue}}" bindchange="onPhaseBuildingChange" bindcolumnchange="onPhaseColumnChange">
        <view class="form-picker">
          <text class="{{editForm.phase && editForm.building ? '' : 'placeholder'}}">{{editForm.phase && editForm.building ? editForm.phase + ' ' + editForm.building : '房号'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>
</mp-half-screen-dialog>
