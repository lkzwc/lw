<!--pages/admin/notice/notice.wxml-->
<view class="page">
  <!-- 操作栏 -->
  <view class="action-bar">
    <text class="count">共 {{totalCount}} 条</text>
    <button class="add-btn" bindtap="onAddNotice">+ 新增</button>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view class="list-item" wx:for="{{notices}}" wx:key="_id">
      <view class="item-main" bindtap="onEditNotice" data-id="{{item._id}}">
        <view class="item-title">{{item.title}}</view>
        <view class="item-row">
          <text class="item-time">{{item.createTimeStr}}</text>
          <text class="item-status {{item.status === 'active' ? 'active' : ''}}">{{item.status === 'active' ? '已发布' : '草稿'}}</text>
        </view>
      </view>
      <view class="item-actions">
        <text class="btn-link" catchtap="onEditNotice" data-id="{{item._id}}">编辑</text>
        <text class="btn-danger" catchtap="onDeleteNotice" data-id="{{item._id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && notices.length === 0}}">
    <text>暂无公告</text>
  </view>
</view>

<!-- 半屏弹窗 -->
<mp-half-screen-dialog
  ext-class="notice-dialog"
  show="{{showModal}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onCloseModal"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">{{editId ? '编辑公告' : '新增公告'}}</text>
    <view class="dialog-submit-btn" bindtap="onSaveNotice">保存</view>
  </view>
  <view slot="desc" class="dialog-body">
    <view class="form-section">
      <input class="form-input" placeholder="公告标题（必填）" value="{{formData.title}}" bindinput="onTitleInput" maxlength="50" />
    </view>
    <view class="form-section">
      <textarea class="form-textarea" placeholder="公告内容（必填）" value="{{formData.content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
      <view class="word-count">{{formData.content.length || 0}}/500</view>
    </view>
    <view class="form-section">
      <view class="form-switch">
        <text>{{formData.status === 'active' ? '已发布' : '草稿'}}</text>
        <switch checked="{{formData.status === 'active'}}" bindchange="onStatusChange" color="#4A90D9" />
      </view>
    </view>
  </view>
</mp-half-screen-dialog>

<loading wx:if="{{loading}}"></loading>
