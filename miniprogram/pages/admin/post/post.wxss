/* pages/admin/post/post.wxss */

.page {
  padding: 20rpx;

  background: #f5f7fa;
}

.stat-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #999;
}

.list {
  background: #fff;
  border-radius: 12rpx;
  overflow: visible;
}

/* slideview 删除按钮高度跟随列表项 */
.slideview-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.slideview-item:last-child {
  border-bottom: none;
}

.slideview-item .weui-slideview__btn__wrp {
  display: flex;
  align-items: center;
  justify-content: center;
}

.slideview-item .weui-slideview__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100% !important;
}

.list-item {
  padding: 24rpx 20rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.meta-num {
  font-size: 22rpx;
  color: #bbb;
  margin-right: 12rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 26rpx;
}