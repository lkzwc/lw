/* pages/admin/post/post.wxss */

.page {
  padding: 20rpx;
  
  background: #f5f7fa;
}

.stat-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #999;
}

.list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.list-item {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-main {
  margin-bottom: 12rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.item-meta {
  font-size: 22rpx;
  color: #bbb;
}

.item-meta text {
  margin-right: 16rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  font-size: 24rpx;
}

.btn-link {
  color: #4A90D9;
}

.btn-danger {
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 26rpx;
}