/* pages/admin/post/post.wxss */

.page {
  padding: 20rpx;

  background: #f5f7fa;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  overflow: hidden;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  box-shadow: none;
  border-bottom: none;
}

.nav-placeholder {
  width: 100%;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--spacing-md);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-right {
  width: 72rpx;
}

.stat-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #999;
}

.list {
  background: #fff;
  border-radius: 12rpx;
  overflow: visible;
}

/* slideview 删除按钮高度跟随列表项 */
.slideview-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.slideview-item:last-child {
  border-bottom: none;
}

.slideview-item .weui-slideview__btn__wrp {
  display: flex;
  align-items: center;
  justify-content: center;
}

.slideview-item .weui-slideview__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100% !important;
}

.list-item {
  padding: 24rpx 20rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.meta-num {
  font-size: 22rpx;
  color: #bbb;
  margin-right: 12rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 26rpx;
}