/* pages/admin/skill/skill.wxss */

.page {
  padding: 20rpx;
  
  background: #f5f7fa;
}

.stat-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #999;
}

.list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.list-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-main {
  margin-bottom: 12rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-row.sub {
  margin-top: 8rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.item-price {
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: 500;
}

.item-user {
  font-size: 24rpx;
  color: #999;
}

.item-category {
  font-size: 22rpx;
  color: #bbb;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.btn-danger {
  font-size: 24rpx;
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal {
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 20rpx 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-row {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.input.short {
  width: 160rpx;
  margin-left: 16rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  color: #333;
}

.modal-foot {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background: #fff;
}

.btn::after {
  border: none;
}

.btn.cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.btn.primary {
  color: #4A90D9;
  font-weight: 500;
}