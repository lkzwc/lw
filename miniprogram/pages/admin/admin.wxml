<!--pages/admin/admin.wxml-->
<view class="admin-page">
  <!-- 数据看板 -->
  <view class="dashboard">
    <view class="dashboard-title">数据概览</view>
    <view class="dashboard-grid">
      <view class="stat-card">
        <text class="stat-value">{{totalPosts}}</text>
        <text class="stat-label">帖子</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{totalSkills}}</text>
        <text class="stat-label">技能</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{totalComments}}</text>
        <text class="stat-label">评论</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{totalUsers}}</text>
        <text class="stat-label">用户</text>
      </view>
    </view>
    <view class="online-bar">
      <text class="online-label">今日活跃</text>
      <text class="online-value">{{todayOnline}}</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="action-grid">
    <view class="action-btn" bindtap="onNoticeManage">
      <text class="action-icon">📢</text>
      <text class="action-text">公告</text>
    </view>
    <view class="action-btn" bindtap="onPostManage">
      <text class="action-icon">📝</text>
      <text class="action-text">帖子</text>
    </view>
    <view class="action-btn" bindtap="onSkillManage">
      <text class="action-icon">🛠️</text>
      <text class="action-text">技能</text>
    </view>
    <view class="action-btn" bindtap="onUserManage">
      <text class="action-icon">👥</text>
      <text class="action-text">用户</text>
    </view>
  </view>
</view>