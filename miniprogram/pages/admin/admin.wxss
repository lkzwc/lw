/* pages/admin/admin.wxss */

.admin-page {
  padding: 24rpx;

  background-color: #f5f7fa;
}

/* 数据看板 */
.dashboard {
  background: var(--gradient-primary);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.dashboard-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.online-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.online-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.online-value {
  font-size: 32rpx;
  font-weight: 600;
}

/* 功能入口 */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-btn {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.action-btn:active {
  transform: scale(0.96);
  background: #f8f9fa;
}


.action-text {
  font-size: 26rpx;
  color: #333;
}