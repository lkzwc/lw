/* pages/discuss-detail/discuss-detail.wxss - 议题详情 */

.detail-page {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 议题信息 ========== */
.topic-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: var(--spacing-md);
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.topic-title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--spacing-sm);
}

.topic-title {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.topic-status {
  flex-shrink: 0;
  font-size: var(--font-xs);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-left: var(--spacing-sm);
}

.status-discussing { background: rgba(74,144,217,0.1); color: #4A90D9; }
.status-voting { background: rgba(250,173,20,0.1); color: #FAAD14; }
.status-resolved { background: rgba(82,196,26,0.1); color: #52C41A; }

.topic-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: var(--spacing-sm);
}

.topic-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.topic-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.topic-author {
  font-size: var(--font-xs);
  color: var(--text-primary);
  font-weight: 500;
}

.topic-time {
  font-size: 20rpx;
  color: var(--text-placeholder);
  margin-left: auto;
}

/* ========== 投票横幅 ========== */
.vote-banner {
  margin: 0 var(--spacing-md) var(--spacing-md);
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F0F6FF 0%, #F5F0FF 100%);
  border: 2rpx solid rgba(74, 144, 217, 0.15);
}

.vote-banner-header {
  padding: 24rpx var(--spacing-md) 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.vote-banner-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(74, 144, 217, 0.12);
  color: #4A90D9;
  line-height: 1.5;
}

/* 截止后 tag 变色 */
.vote-banner.vote-ended .vote-banner-tag {
  background: rgba(140, 140, 140, 0.12);
  color: #8C8C8C;
}

.vote-banner-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  margin-top: 2rpx;
}

/* 进度条 */
.vote-bar-wrap {
  padding: 0 var(--spacing-md) 8rpx;
}

.vote-bar-track {
  height: 14rpx;
  border-radius: 7rpx;
  background: #FFE8E5;
  overflow: hidden;
  position: relative;
}

.vote-bar-approve {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #8BCF6D, #52C41A);
  transition: width 0.3s ease;
  min-width: 0;
}

.vote-bar-labels {
  display: flex;
  justify-content: space-between;
  padding-top: 8rpx;
}

.vote-bar-label {
  font-size: 22rpx;
  font-weight: 500;
}

.vote-bar-label.approve { color: #52C41A; }
.vote-bar-label.reject { color: #FF4D4F; }

/* 底部按钮 */
.vote-banner-footer {
  padding: 8rpx var(--spacing-md) 20rpx;
}

.vote-btns {
  display: flex;
  gap: var(--spacing-md);
}

.vote-opt-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.15s;
}

.vote-opt-btn::after { border: none; }

.vote-opt-btn.approve {
  background: linear-gradient(135deg, #8BCF6D, #52C41A);
  color: #FFFFFF;
}

.vote-opt-btn.reject {
  background: linear-gradient(135deg, #FF7875, #FF4D4F);
  color: #FFFFFF;
}

.vote-opt-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 已投票提示 */
.vote-voted-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.vote-remain {
  color: #4A90D9;
  font-weight: 500;
}

/* 已截止 */
.vote-ended-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-placeholder);
  padding: 8rpx 0;
}

/* 发起投票按钮 */
.start-vote-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: var(--spacing-md);
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  border: 2rpx dashed #D9D9D9;
}


.btn-text {
  font-size: var(--font-base);
  color: #4A90D9;
  font-weight: 500;
}

/* ========== 消息区域 ========== */
.chat-area {
  height: calc(100vh - 520rpx);
  overflow-y: scroll;
}

.chat-messages {
  padding: var(--spacing-md);
}

.message-item {
  margin-bottom: var(--spacing-md);
}

.time-divider {
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.time-divider text {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
  background: #F5F7FA;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.message-content {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.message-item.mine .message-content {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-body {
  max-width: 70%;
}

.message-name {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
  margin-bottom: 4rpx;
  display: block;
}

.message-item.mine .message-name {
  text-align: right;
}

.message-bubble {
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.message-item.mine .message-bubble {
  background: rgba(74,144,217,0.1);
}

.message-text {
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.6;
}

.message-time {
  font-size: 20rpx;
  color: var(--text-placeholder);
}

.message-item.mine .message-time {
  text-align: right;
}

.reply-to-name {
  font-size: 22rpx;
  color: #4A90D9;
  display: block;
  margin-bottom: 4rpx;
}

.load-more-tip {
  text-align: center;
  padding: var(--spacing-sm);
  color: var(--text-placeholder);
  font-size: var(--font-xs);
}

/* ========== 输入区域 ========== */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-sm) var(--spacing-md);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}

.input-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.message-input {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 36rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-base);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}

.send-btn.active {
  opacity: 1;
}


/* ========== 弹窗 ========== */
.dialog-body {
  overflow-x: hidden;
  padding: 0 8rpx;
}

.form-section {
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker .placeholder {
  color: var(--text-placeholder);
}

.picker-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
