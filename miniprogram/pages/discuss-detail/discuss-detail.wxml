<!--pages/discuss-detail/discuss-detail.wxml - 议题详情-->
<view class="detail-page">

  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-bar nav-bar-simple">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view style="height: {{statusBarHeight + 44}}px;"></view>

  <!-- 议题信息 -->
  <view class="topic-section" wx:if="{{topic}}">
    <view class="topic-header">
      <view class="topic-title-row">
        <text class="topic-title">{{topic.title}}</text>
        <text class="topic-status status-{{topic.status}}">{{topic.statusText}}</text>
      </view>
      <text class="topic-desc">{{topic.description}}</text>
      <view class="topic-meta">
        <image class="topic-avatar" src="{{topic.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
        <text class="topic-author">{{topic.author}}</text>
        <text class="topic-time">{{topic.createTime}}</text>
      </view>
    </view>
  </view>

  <!-- 投票区域 -->
  <view class="vote-section" wx:if="{{topic.vote}}">
    <view class="vote-header">
      <text class="vote-title">🗳 {{topic.vote.title}}</text>
      <text class="vote-deadline">截止：{{topic.vote.deadline}}</text>
    </view>
    <view class="vote-stats">
      <text class="vote-count approve">👍 {{topic.voteApprove || 0}}</text>
      <text class="vote-count reject">👎 {{topic.voteReject || 0}}</text>
    </view>
    <view class="vote-actions" wx:if="{{!topic.myVote}}">
      <button class="vote-btn approve" bindtap="onVoteApprove">赞成</button>
      <button class="vote-btn reject" bindtap="onVoteReject">反对</button>
    </view>
    <view class="vote-result" wx:if="{{topic.myVote}}">
      <text class="result-text">✓ 您已投票</text>
    </view>
  </view>

  <!-- 发起投票按钮 -->
  <view class="start-vote-btn" wx:if="{{topic && topic.isAuthor && !topic.vote}}" bindtap="onStartVote">
    <text class="iconfont icon-pinglun icon-md"></text>
    <text class="btn-text">发起投票</text>
  </view>

  <!-- 消息区域 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="{{scrollToView}}" bindscrolltoupper="onScrollToUpper">
    <view class="chat-messages">
      <view class="message-item {{item.isMine ? 'mine' : 'other'}}" wx:for="{{messages}}" wx:key="_id" id="msg-{{item._id}}">
        <view class="time-divider" wx:if="{{item.showTime}}">
          <text>{{item.dateStr}}</text>
        </view>
        <view class="message-content" catchtap="onReplyTap" data-item="{{item}}">
          <image class="message-avatar" src="{{item.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="message-body">
            <text class="message-name" wx:if="{{!item.isMine}}">{{item.nickName}}</text>
            <view class="message-bubble">
              <text class="reply-to-name" wx:if="{{item.replyToName}}">回复 @{{item.replyToName}}：</text>
              <text class="message-text">{{item.content}}</text>
            </view>
            <text class="message-time">{{item.displayTime}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-bar">
      <input class="message-input" placeholder="{{replyTo ? '回复 @' + replyTo.nickName : '发表您的看法...'}}" value="{{inputContent}}" bindinput="onInput" bindblur="onInputBlur" bindconfirm="onSend" />
      <view class="send-btn {{inputContent ? 'active' : ''}}" bindtap="onSend">
        <text class="iconfont icon-send icon-md"></text>
      </view>
    </view>
  </view>

</view>

<!-- 发起投票半屏弹窗 -->
<mp-half-screen-dialog
  ext-class="vote-dialog"
  show="{{showVotePopup}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onCloseVotePopup"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">发起投票</text>
    <view class="dialog-submit-btn {{voteForm.title ? '' : 'disabled'}}" bindtap="onSubmitVote">
      <text>发起</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <view class="form-section">
      <input class="form-input" placeholder="投票议题（必填）" value="{{voteForm.title}}" bindinput="onVoteTitleInput" />
    </view>
    <view class="form-section">
      <picker mode="multiSelector" range="{{timeRange}}" value="{{voteForm.timeIndex}}" bindchange="onTimePick">
        <view class="form-picker">
          <text class="{{voteForm.deadline ? '' : 'placeholder'}}">{{voteForm.deadline || '截止时间'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>
</mp-half-screen-dialog>

<loading wx:if="{{loading}}"></loading>
