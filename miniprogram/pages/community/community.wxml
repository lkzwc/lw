<!--pages/community/community.wxml - 按设计图重构-->
<view class="community-page">

  <!-- 顶部标题栏 -->
  <view class="page-header">
    <!-- 背景图 -->
    <image class="page-header-bg" src="/assets/images/homebg.jpeg" mode="aspectFill"></image>
    <!-- 渐变蒙层 -->
    <view class="page-header-mask"></view>
    <!-- 动态光效 -->
    <view class="page-header-glow"></view>
    <!-- 内容层 -->
    <view class="header-content">
      <text class="page-title">社区动态</text>
      <text class="page-subtitle">分享生活，连接邻里</text>
      <!-- 搜索栏 -->
      <view class="search-bar" bindtap="onSearchTap" style="margin-top: 24rpx;">
        <text class="iconfont icon-sousuo search-icon-font"></text>
        <text class="search-placeholder">搜索帖子、话题...</text>
      </view>
    </view>
  </view>

  <!-- 帖子列表 -->
  <view class="posts-list">
    <view class="post-card" wx:for="{{posts}}" wx:key="_id" bindtap="onPostTap" data-id="{{item._id}}" data-index="{{index}}">
      <view class="post-header">
        <image class="post-avatar" src="{{item.userInfo.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
        <view class="post-user">
          <text class="post-name">{{item.userInfo.nickName}}</text>
          <text class="post-time">{{item.timeStr}}</text>
        </view>
        <view class="post-tag" wx:if="{{item.tag}}">#{{item.tag}}</view>
      </view>

      <text class="post-content">{{item.content}}</text>

      <!-- 图片 -->
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <image
          class="post-image {{item.images.length === 1 ? 'single' : ''}}"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          catchtap="onImageTap"
          data-images="{{item.images}}"
          data-current="{{img}}"
        ></image>
      </view>

      <!-- 互动区 -->
      <view class="post-footer">
        <view class="post-stat {{item.isLiked ? 'liked' : ''}}" catchtap="onLikeTap" data-id="{{item._id}}">
          <text class="iconfont {{item.isLiked ? 'icon-dianzan1' : 'icon-dianzan'}} stat-icon-font"></text>
          <text class="stat-num">{{item.likeCount || 0}}</text>
        </view>
        <view class="post-stat" catchtap="onCommentBtnTap" data-id="{{item._id}}" data-index="{{index}}">
          <text class="iconfont icon-pinglun stat-icon-font"></text>
          <text class="stat-num">{{item.commentCount || 0}}</text>
        </view>
        <button class="post-stat share-btn" open-type="share" catchtap="stopPropagation">
          <text class="iconfont icon-zhuanfa stat-icon-font"></text>
          <text class="stat-num">转发</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{posts.length === 0 && !loading}}">
    <text class="iconfont icon-tiezhi empty-icon-font"></text>
    <text class="empty-text">暂无帖子</text>
    <text class="empty-hint">点击右下角发布第一条帖子</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{posts.length > 0 && hasMore}}">
    <text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{posts.length > 0 && !hasMore}}">
    <text>没有更多了</text>
  </view>

</view>

<!-- 发布按钮 -->
<view class="publish-btn" bindtap="onPublishTap">
  <text class="iconfont icon-tianjia publish-icon-font"></text>
</view>

<!-- 发布帖子半屏弹窗 - Twitter风格 -->
<mp-half-screen-dialog
  ext-class="publish-dialog"
  show="{{showPublishDialog}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onClosePublishDialog"
>
  <view slot="title" class="dialog-title-row">
    <text class="dialog-title">发布帖子</text>
    <view class="dialog-submit-btn {{publishForm.content ? '' : 'disabled'}}" bindtap="onSubmitPost">
      <text>发布</text>
    </view>
  </view>
  <view slot="desc" class="dialog-body">
    <!-- 内容输入区 -->
    <view class="publish-content-area">
      <textarea
        class="publish-textarea"
        placeholder="分享你的生活点滴... #标签 会自动识别"
        value="{{publishForm.content}}"
        bindinput="onContentInput"
        maxlength="500"
        auto-height
        adjust-position="{{true}}"
      ></textarea>
      <text class="form-count">{{publishForm.content.length || 0}}/500</text>
    </view>

    <!-- 自动识别的标签 -->
    <view class="auto-tags" wx:if="{{publishForm.detectedTags.length > 0}}">
      <text class="auto-tags-label">识别标签</text>
      <view class="auto-tags-list">
        <text class="auto-tag" wx:for="{{publishForm.detectedTags}}" wx:key="*this">#{{item}}</text>
      </view>
    </view>

    <!-- 手动标签 -->
    <view class="manual-tags">
      <text class="manual-tags-label">快捷标签</text>
      <view class="tag-options">
        <view class="tag-option {{publishForm.tag === '求助' ? 'active' : ''}}" bindtap="onTagSelect" data-tag="求助">求助</view>
        <view class="tag-option {{publishForm.tag === '分享' ? 'active' : ''}}" bindtap="onTagSelect" data-tag="分享">分享</view>
        <view class="tag-option {{publishForm.tag === '闲聊' ? 'active' : ''}}" bindtap="onTagSelect" data-tag="闲聊">闲聊</view>
      </view>
    </view>

    <!-- 图片上传 -->
    <view class="publish-images">
      <view class="image-item" wx:for="{{publishForm.images}}" wx:key="*this">
        <image class="preview-image" src="{{item}}" mode="aspectFill"></image>
        <view class="delete-btn" bindtap="onDeleteImage" data-index="{{index}}">×</view>
      </view>
      <view class="image-add-btn" wx:if="{{publishForm.images.length < 6}}" bindtap="onAddImage">
        <text class="iconfont icon-shangchuantupian upload-icon"></text>
        <text class="image-count">{{publishForm.images.length}}/6</text>
      </view>
    </view>
  </view>
</mp-half-screen-dialog>

<!-- ===== 评论半屏弹窗 — 参考 awesome-skyline half-screen 样式 ===== -->
<mp-half-screen-dialog
  ext-class="comment-dialog"
  show="{{showCommentDialog}}"
  maskClosable="{{true}}"
  closable="{{true}}"
  bindclose="onCloseCommentDialog"
>
  <view slot="title" class="comment-dialog-title">
    <text>评论 {{currentPost.commentCount ? '(' + currentPost.commentCount + ')' : ''}}</text>
  </view>

  <view slot="desc" class="comment-dialog-body">

    <!-- 帖子摘要区 -->
    <view class="comment-post-summary" wx:if="{{currentPost._id}}">
      <image class="summary-avatar" src="{{currentPost.userInfo.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      <view class="summary-info">
        <text class="summary-name">{{currentPost.userInfo.nickName || '邻居'}}</text>
        <text class="summary-content">{{currentPost.content}}</text>
      </view>
    </view>

    <!-- 评论列表区 — 使用 scroll-view 确保可滚动，不溢出到输入区 -->
    <scroll-view class="comment-scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
      <!-- 加载中 -->
      <view class="comment-loading" wx:if="{{commentLoading}}">
        <text class="comment-loading-text">加载中...</text>
      </view>

      <!-- 评论条目 — 参考源码横向布局：头像 + (昵称/内容) -->
      <view class="comment-item" wx:for="{{currentComments}}" wx:key="_id" wx:if="{{!commentLoading}}">
        <image class="comment-user-avatar" src="{{item.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
        <view class="comment-user-info">
          <text class="comment-user-name">{{item.userName}}</text>
          <text class="comment-user-content">{{item.content}}</text>
          <text class="comment-user-time">{{item.timeStr}}</text>
        </view>
      </view>

      <!-- 空评论 -->
      <view class="comment-empty" wx:if="{{currentComments.length === 0 && !commentLoading}}">
        <text class="comment-empty-text">还没有评论，来抢沙发~</text>
      </view>
    </scroll-view>

  </view>

  <!-- 底部输入区 — footer slot 固定底部，独立于滚动区 -->
  <view slot="footer" class="comment-input-area">
    <image class="comment-input-avatar" src="{{userAvatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
    <input
      class="comment-input-box"
      placeholder="说点什么..."
      value="{{commentInput}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="onSendComment"
      adjust-position="{{true}}"
    />
    <view class="comment-send-btn {{commentInput.trim() ? '' : 'disabled'}}" catchtap="onSendComment">
      <text>发送</text>
    </view>
  </view>

</mp-half-screen-dialog>

<!-- 加载状态 -->
<loading wx:if="{{loading}}"></loading>

