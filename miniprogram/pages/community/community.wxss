/* pages/community/community.wxss - 统一浅蓝色主题 */

.community-page {
  overflow-x: hidden;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 页面头部 */
.page-header {
  position: relative;
  overflow: hidden;
  padding: var(--spacing-lg);
  padding-top: calc(88rpx + env(safe-area-inset-top));
  border-radius: 0 0 40rpx 40rpx;
}

/* 背景图 */
.page-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 渐变蒙层 */
.page-header-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.85) 0%, rgba(107, 168, 232, 0.75) 50%, rgba(74, 144, 217, 0.9) 100%);
  z-index: 1;
}

/* 动态光效 */
.page-header-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 50%);
  animation: glowMove 8s ease-in-out infinite;
  z-index: 2;
}

@keyframes glowMove {
  0%, 100% {
    transform: translate(0, 0);
    opacity: 0.5;
  }
  50% {
    transform: translate(-10%, 10%);
    opacity: 0.8;
  }
}

/* 内容层 */
.header-content {
  position: relative;
  z-index: 3;
}

.page-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}

/* 搜索栏 - 集成在头部 */
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
}

.search-bar .iconfont {
  margin-right: var(--spacing-sm);
}

.search-placeholder {
  font-size: var(--font-base);
  color: rgba(255, 255, 255, 0.6);
}

/* 帖子列表 */
.posts-list {
  padding: 0 var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.post-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: var(--spacing-sm);
}

.post-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.post-name {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
}

.post-time {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.post-tag {
  font-size: var(--font-xs);
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 图片 */
.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.post-image.single {
  width: 320rpx;
  height: 240rpx;
}

/* 互动区 */

.stat-num {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.share-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx var(--spacing-lg);
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: var(--spacing-lg);
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}


/* ===== 评论半屏弹窗 — 参考 awesome-skyline half-screen 样式 ===== */

/* 覆盖 WeUI half-screen-dialog 内部默认间距 */
.comment-dialog .weui-half-screen-dialog__ft {
  padding: 0 !important;
}

.comment-dialog .weui-half-screen-dialog__bd {
  padding: 0 !important;
  overflow: hidden;
}

.comment-dialog .weui-half-screen-dialog__hd {
  padding-bottom: 0 !important;
}

/* 弹窗 body — flex 列布局，scroll-view 自适应撑满 */
.comment-dialog-body {
  display: flex;
  flex-direction: column;
  padding: 0 !important;
  overflow: hidden;
}

/* 标题栏 */
.comment-dialog-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A191E;
}

/* 帖子摘要区 */
.comment-post-summary {
  flex-shrink: 0;
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  background: #FAFAFA;
}

.summary-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.summary-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.summary-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1A191E;
  margin-bottom: 6rpx;
}

.summary-content {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 评论列表区 — 交由弹窗自身滚动 */

/* 加载中 */
.comment-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
}

.comment-loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 评论条目 — 参考：横向布局 头像+(昵称/内容) */
.comment-item {
  display: flex;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

/* 二级评论（回复）— 明显缩进 + 浅色背景 */
.comment-item.reply {
  padding: 20rpx 32rpx 20rpx 72rpx;
  background: #F8FAFB;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-user-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* 二级评论头像更小 */
.comment-user-avatar.reply-avatar {
  width: 48rpx;
  height: 48rpx;
}

.comment-user-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.comment-user-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #1A191E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.comment-user-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.comment-user-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

/* 回复 @用户名 标签 */
.reply-to {
  color: #4A90D9;
  font-size: 26rpx;
  margin-right: 4rpx;
}

.comment-user-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 空评论 */
.comment-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.comment-empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 评论滚动区 — 占据弹窗剩余空间，设定具体高度确保滚动 */
/* 半屏弹窗默认占 70vh，摘要区约 120rpx，留出足够空间 */
.comment-scroll-area {
  height: calc(70vh - 200rpx);
}

/* 底部输入区 — footer slot，组件已处理 safe-area */
.comment-input-area {
  padding: 0;
  background: #FFFFFF;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.comment-input-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.comment-input-box {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1A191E;
}

.comment-send-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

.comment-send-btn.disabled {
  background: #C8DCF0;
  color: #FFFFFF;
}

.publish-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  padding: var(--spacing-md);
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.form-count {
  display: block;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

/* 图片上传区 */
.publish-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  overflow: hidden;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.image-add-btn {
  width: 160rpx;
  height: 160rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D8D8D8;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-placeholder);
  margin-bottom: 8rpx;
}

.image-count {
  font-size: 22rpx;
  color: var(--text-placeholder);
}
