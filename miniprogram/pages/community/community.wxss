/* pages/community/community.wxss - 统一浅蓝色主题 */

.community-page {
  overflow-x: hidden;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 页面头部 */
.page-header {
  position: relative;
  overflow: hidden;
  padding: var(--spacing-lg);
  padding-top: calc(88rpx + env(safe-area-inset-top));
  border-radius: 0 0 40rpx 40rpx;
}

/* 背景图 */
.page-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 渐变蒙层 */
.page-header-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.85) 0%, rgba(107, 168, 232, 0.75) 50%, rgba(74, 144, 217, 0.9) 100%);
  z-index: 1;
}

/* 动态光效 */
.page-header-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 50%);
  animation: glowMove 8s ease-in-out infinite;
  z-index: 2;
}

@keyframes glowMove {
  0%, 100% {
    transform: translate(0, 0);
    opacity: 0.5;
  }
  50% {
    transform: translate(-10%, 10%);
    opacity: 0.8;
  }
}

/* 内容层 */
.header-content {
  position: relative;
  z-index: 3;
}

.page-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}

/* 搜索区域 */
.search-section {
  padding: var(--spacing-md);
}

.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: var(--spacing-sm);
}

.search-placeholder {
  font-size: var(--font-base);
  color: var(--text-placeholder);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  padding: 0 var(--spacing-md) var(--spacing-md);
  gap: var(--spacing-sm);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  font-weight: 500;
}

/* 帖子列表 */
.posts-list {
  padding: 0 var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.post-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: var(--spacing-sm);
}

.post-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.post-name {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
}

.post-time {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.post-tag {
  font-size: var(--font-xs);
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.post-content {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--spacing-sm);
}

/* 图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.post-image.single {
  width: 320rpx;
  height: 240rpx;
}

/* 互动区 */
.post-footer {
  display: flex;
  justify-content: space-around;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid #F0F0F0;
}

.post-stat {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.post-stat.liked .stat-icon-font {
  color: #FF6B6B;
  transform: scale(1.2);
}

.stat-icon-font {
  font-size: 40rpx;
  color: #999999;
  transition: transform 0.2s;
}

.stat-num {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.share-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx var(--spacing-lg);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: var(--spacing-lg);
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: var(--spacing-md);
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.publish-icon {
  font-size: 48rpx;
  color: #FFFFFF;
}

/* ========== 半屏弹窗样式 ========== */
.dialog-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.dialog-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.dialog-submit-btn {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: var(--font-base);
  font-weight: 500;
}

.dialog-submit-btn.disabled {
  background: #E8E8E8;
  color: var(--text-placeholder);
}

.dialog-body {
  padding: var(--spacing-sm) 0 0;
  overflow-x: hidden;
}

/* 发布内容区 - Twitter风格 */
.publish-content-area {
  margin-bottom: var(--spacing-md);
}

.publish-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E4EA;
  border-radius: 16rpx;
  padding: var(--spacing-md);
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.form-count {
  display: block;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

/* 自动识别标签 */
.auto-tags {
  margin-bottom: var(--spacing-md);
  padding: 16rpx 20rpx;
  background: rgba(74, 144, 217, 0.06);
  border-radius: 12rpx;
}

.auto-tags-label {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-bottom: 12rpx;
  display: block;
}

.auto-tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.auto-tag {
  font-size: 26rpx;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 手动标签 */
.manual-tags {
  margin-bottom: var(--spacing-md);
}

.manual-tags-label {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-bottom: 12rpx;
  display: block;
}

.tag-options {
  display: flex;
  gap: var(--spacing-sm);
}

.tag-option {
  padding: 12rpx 32rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
  font-size: var(--font-base);
  color: var(--text-secondary);
}

.tag-option.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  color: #FFFFFF;
}

/* 图片上传区 */
.publish-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  overflow: hidden;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.image-add-btn {
  width: 160rpx;
  height: 160rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D8D8D8;
}

.upload-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.image-count {
  font-size: 22rpx;
  color: var(--text-placeholder);
}