<!--pages/activity-detail/activity-detail.wxml-->
<view class="detail-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-placeholder" style="height: {{statusBarHeight || 0}}px;"></view>
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">活动详情</text>
      <view class="nav-right"></view>
    </view>
  </view>
  <view style="height: {{(statusBarHeight || 0) + 44}}px;"></view>

  <!-- 活动图片 -->
  <view class="detail-images" wx:if="{{activity.images && activity.images.length > 0}}">
    <image
      class="detail-image"
      wx:for="{{activity.images}}"
      wx:key="*this"
      src="{{item}}"
      mode="aspectFill"
      bindtap="onImageTap"
      data-images="{{activity.images}}"
      data-current="{{item}}"
    ></image>
  </view>
  <image class="detail-cover" src="{{activity.cover}}" mode="aspectFill" wx:elif="{{activity.cover}}"></image>
  <view class="detail-cover-placeholder" wx:else>
    <text class="iconfont icon-rili icon-huge"></text>
  </view>
  
  <!-- 活动信息 -->
  <view class="detail-content">
    
    <!-- 标题区 -->
    <view class="detail-header">
      <text class="detail-title">{{activity.title}}</text>
      <view class="detail-status status-{{activity.status}}">
        {{activity.status === 'ongoing' ? '进行中' : activity.status === 'upcoming' ? '即将开始' : '已结束'}}
      </view>
    </view>
    
    <!-- 信息卡片 -->
    <view class="info-card card">
      <view class="info-row">
        <view class="info-icon"><text class="iconfont icon-dingwei icon-md"></text></view>
        <view class="info-text">
          <text class="info-label">活动地点</text>
          <text class="info-value">{{activity.location}}</text>
        </view>
      </view>
      <view class="info-row">
        <view class="info-icon"><text class="iconfont icon-naozhong_huaban1 icon-md"></text></view>
        <view class="info-text">
          <text class="info-label">活动时间</text>
          <text class="info-value">{{activity.timeStr || activity.time || activity.date}}</text>
        </view>
      </view>
      <view class="info-row">
        <view class="info-icon"><text class="iconfont icon-yonghu info-people-icon"></text></view>
        <view class="info-text">
          <text class="info-label">报名人数</text>
          <text class="info-value">{{activity.joinCount}}人已报名</text>
        </view>
      </view>
    </view>
    
    <!-- 活动详情 -->
    <view class="section">
      <text class="section-title">活动详情</text>
      <text class="section-content">{{activity.desc || '暂无详情'}}</text>
    </view>
    
    <!-- 参与者 -->
    <view class="section" wx:if="{{activity.joinAvatars && activity.joinAvatars.length > 0}}">
      <text class="section-title">已报名邻居</text>
      <view class="join-list">
        <image class="join-avatar" wx:for="{{activity.joinAvatars}}" wx:key="*this" src="{{item || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      </view>
    </view>
    
  </view>
  
  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="share-btn" open-type="share">
      <text class="iconfont icon-zhuanfa icon-lg"></text>
      <text>转发</text>
    </button>
    <button class="join-btn {{activity.isJoined ? 'joined' : ''}}" bindtap="onJoinTap">
      <text>{{activity.isJoined ? '取消报名' : '立即报名'}}</text>
    </button>
  </view>
  
</view>

<loading wx:if="{{loading}}"></loading>
