/* pages/activity-detail/activity-detail.wxss - 统一暖橙色主题 */

.detail-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  overflow: hidden;
  background: linear-gradient(135deg, #3DB94F 0%, #52C41A 100%);
  box-shadow: none;
  border-bottom: none;
}

.nav-placeholder {
  width: 100%;
  background: linear-gradient(135deg, #3DB94F 0%, #52C41A 100%);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--spacing-md);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-right {
  width: 72rpx;
}

/* 活动封面 */
.detail-cover {
  width: 100%;
  height: 400rpx;
}

.detail-cover-placeholder {
  width: 100%;
  height: 400rpx;
  background: linear-gradient(135deg, #E8F0F8 0%, #F0F5FA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 活动内容 */
.detail-content {
  padding: var(--spacing-md);
  margin-top: -40rpx;
}

/* 标题区 */
.detail-header {
  background: #FFFFFF;
  border-radius: 16rpx 16rpx 0 0;
  padding: var(--spacing-md);
  padding-bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-title {
  flex: 1;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.detail-status {
  font-size: var(--font-xs);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-ongoing {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.status-upcoming {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.status-ended {
  
  color: var(--text-placeholder);
}

/* 信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 0 0 16rpx 16rpx;
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid #F0F0F0;
}

.info-icon {
  font-size: 32rpx;
  margin-right: var(--spacing-md);
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-people-icon {
  color: #52C41A;
  font-size: 32rpx;
}

.info-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.info-value {
  font-size: var(--font-base);
  color: var(--text-primary);
  font-weight: 500;
}

/* 内容区块 */
.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
}

.section-content {
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 参与者列表 */
.join-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.join-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.share-btn {
  width: 160rpx;
  height: 88rpx;
  
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-base);
  color: var(--text-secondary);
  border: none;
}

.share-btn::after {
  border: none;
}

.join-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA8E8 100%);
  border-radius: 44rpx;
  font-size: var(--font-md);
  font-weight: 600;
  color: #FFFFFF;
  border: none;
}

.join-btn::after {
  border: none;
}

.join-btn.joined {
  
  color: var(--text-secondary);
}